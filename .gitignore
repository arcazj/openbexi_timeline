# Dependencies and generated build output
/data/
/node_modules/
/.venv/
__pycache__/
*.egg-info/
/.pytest_cache/
/dist/
/build/
/target/
/out/
/lib/openbexi_timeline.jar
/tests/local-java/

# Local runtime state, deployment integrations, logs, and IDE metadata
/.local-private/
/.idea/
*.iml
/tomcat/
/target_example.json
/json/target_example.json
/tools/com/*/timeline/
/tools/batch/
/src/descriptor4*.js
/json/*_reports.json
/filters/*
!/filters/README.md
/logs/

# Browser output may contain local data. Reviewed public fixtures live in docs/tests.
/img.png
/test-results/
/playwright-report/
/blob-report/

# Only generic root entry points belong in the public project.
/*.html
!/demos.html
!/openbexi_test_timeline.html
!/openbexi_timeline.html
!/openbexi_timeline_earthquake.html
!/openbexi_timeline_model.html
!/openbexi_timeline_model_preview.html
!/openbexi_timeline_embed.html

# Deployment-specific models remain local; keep the public examples explicit.
/models/*
!/models/demos/
!/models/model_template.json
!/models/regular_timeline.json
!/models/regular_timeline_earthquake.json

# Deployment configuration is local unless reviewed as a generic example.
/yaml/*
!/yaml/test-data/
!/yaml/deployment.yaml
!/yaml/service.yaml
!/yaml/sources_container.yml
!/yaml/sources_default.yml
!/yaml/source_template.yml
!/yaml/sources_default_test.yml
!/yaml/sources_earthquake.yml
!/yaml/tomcat.yml
/tools/com/intelsat/

