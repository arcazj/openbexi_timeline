<data wiki-url="http://simile.mit.edu/shelf/" wiki-section="Simile Christianity Timeline">
<event namespace="Christianity" start="1 AD" title="Anno Domini"> <a href="http://en.wikipedia.org/wiki/1_AD" title="1 AD">1 AD</a> First year in <a href="http://en.wikipedia.org/wiki/Anno_Domini" title="Anno Domini">Christian calendar</a>, which is presently used in unison with the <a href="http://en.wikipedia.org/wiki/Gregorian_calendar" title="Gregorian calendar">Gregorian calendar</a> almost everywhere in the world. </event>
<event namespace="Christianity" start="6" title="Herod Archelaus deposed by Augustus"> <a href="http://en.wikipedia.org/wiki/Herod_Archelaus" title="Herod Archelaus">Herod Archelaus</a> deposed by <a href="http://en.wikipedia.org/wiki/Augustus" title="Augustus">Augustus</a> </event>
<event namespace="Christianity" start="6" title="Samaria, Judea, Idumea under Roman admin"> <a href="http://en.wikipedia.org/wiki/Samaria" title="Samaria">Samaria</a>, <a href="http://en.wikipedia.org/wiki/Judea" title="Judea">Judea</a> and <a href="http://en.wikipedia.org/wiki/Idumea" title="Idumea">Idumea</a> annexed as <a href="http://en.wikipedia.org/wiki/Iudaea_Province" title="Iudaea Province">Iudaea Province</a> under direct Roman administration, capital at <a href="http://en.wikipedia.org/wiki/Caesarea_Palaestina" title="Caesarea Palaestina">Caesarea</a>, <a href="http://en.wikipedia.org/wiki/Quirinius" title="Quirinius">Quirinius</a> became <a href="http://en.wikipedia.org/wiki/Legatus" title="Legatus">Legate</a> (Governor) of <a href="http://en.wikipedia.org/wiki/Syria_%28Roman_province%29#Syria_in_antiquity" title="Syria (Roman province)">Syria</a>, conducted first Roman tax census of Iudaea, opposed by <a href="http://en.wikipedia.org/wiki/Zealots" title="Zealots">Zealots</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=%20Acts&verse=5:37&src=NIV" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=%20Acts&verse=5:37&src=NIV">Acts 5:37</a>) </event>
<event namespace="Christianity" start="7" end="26" isDuration="true" title="Peace in Iudaea, Galilee"> Brief period of peace, relatively free of revolt and bloodshed in Iudaea & <a href="http://en.wikipedia.org/wiki/Galilee" title="Galilee">Galilee</a> </event>
<event namespace="Christianity" start="9" title="Hillel the Elder dies, Shammai rises"> <a href="http://en.wikipedia.org/wiki/Pharisee" title="Pharisee">Pharisee</a> leader <a href="http://en.wikipedia.org/wiki/Hillel_the_Elder" title="Hillel the Elder">Hillel the Elder</a> dies, rise of <a href="http://en.wikipedia.org/wiki/Shammai" title="Shammai">Shammai</a> </event>
<event namespace="Christianity" start="14" end="37" isDuration="true" title="Tiberius, Roman Emperor"> <a href="http://en.wikipedia.org/wiki/Tiberius" title="Tiberius">Tiberius</a>, <a href="http://en.wikipedia.org/wiki/Roman_Emperor" title="Roman Emperor">Roman Emperor</a> </event>
<event namespace="Christianity" start="18" end="36" isDuration="true" title="Caiaphas, High Priest of Herod's Temple"> <a href="http://en.wikipedia.org/wiki/Caiaphas" title="Caiaphas">Caiaphas</a>, appointed <a href="http://en.wikipedia.org/wiki/List_of_High_Priests_of_Israel" title="List of High Priests of Israel">High Priest</a> of <a href="http://en.wikipedia.org/wiki/Herod%27s_Temple" title="Herod's Temple">Herod's Temple</a> by Prefect Valerius Gratus, deposed by Syrian Legate <a href="http://en.wikipedia.org/wiki/Vitellius" title="Vitellius">Vitellius</a> </event>
<event namespace="Christianity" start="19" title="Jews, Jewish Proselytes, Astrologers expelled from Rome"> <a href="http://en.wikipedia.org/wiki/Jews" title="Jews">Jews</a>, Jewish <a href="http://en.wikipedia.org/wiki/Proselytes" title="Proselytes">Proselytes</a>, <a href="http://en.wikipedia.org/wiki/Astrologers" title="Astrologers">Astrologers</a>, expelled from Rome (Suetonius,<a href="http://en.wikipedia.org/wiki/Lives_of_the_Twelve_Caesars" title="Lives of the Twelve Caesars">Lives of the Twelve Caesars</a>, Tiberius 36, <a href="http://en.wikipedia.org/wiki/Loeb_Classics" title="Loeb Classics">Loeb Classics</a>) </event>
<event namespace="Christianity" start="26" end="36" isDuration="true" title="Pontius Pilate, Prefect of Iudaea"> <a href="http://en.wikipedia.org/wiki/Pontius_Pilate" title="Pontius Pilate">Pontius Pilate</a>, <a href="http://en.wikipedia.org/wiki/Prefect" title="Prefect">Prefect</a> of Iudaea </event>
<event namespace="Christianity" start="28" end="29" isDuration="true" title="John the Baptist"> <a href="http://en.wikipedia.org/wiki/John_the_Baptist" title="John the Baptist">John the Baptist</a>, relative of Jesus (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Luke%20&verse=1:36&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Luke%20&verse=1:36&src=31">Luke 1:36</a>), a <a href="http://en.wikipedia.org/wiki/Nazirite" title="Nazirite">Nazirite</a> (<a href="http://www.biblegateway.com/passage/?search=Luke%201:15;&version=31;" class="external text" title="http://www.biblegateway.com/passage/?search=Luke%201:15;&version=31;">Luke 1:15</a>), began ministry in "15th year of Tiberius" (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Luke%20&verse=3:1-2&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Luke%20&verse=3:1-2&src=31">Luke 3:1-2</a>), <a href="http://en.wikipedia.org/wiki/Baptism_of_Jesus" title="Baptism of Jesus">baptized Jesus</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Mark%20&verse=1:4-11&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Mark%20&verse=1:4-11&src=31">Mark 1:4-11</a>), arrested and <a href="http://en.wikipedia.org/wiki/Decapitation" title="Decapitation">beheaded</a> by <a href="http://en.wikipedia.org/wiki/Herod_Antipas" title="Herod Antipas">Herod Antipas</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Luke%20&verse=3:19-20&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Luke%20&verse=3:19-20&src=31">Luke 3:19-20</a>,<a href="http://en.wikipedia.org/wiki/Antiquities_of_the_Jews" title="Antiquities of the Jews">JA</a>18.5.2) </event>
<event namespace="Christianity" start="28" end="36" isDuration="true" title="Jesus of Nazareth"> <a href="http://en.wikipedia.org/wiki/Jesus" title="Jesus">Jesus</a>' <a href="http://en.wikipedia.org/wiki/Religious_ministry_%28Christian%29" title="Religious ministry (Christian)">ministry</a>, <a href="http://en.wikipedia.org/wiki/Sermon_on_the_Mount" title="Sermon on the Mount">Sermon on the Mount</a>, appointed <a href="http://en.wikipedia.org/wiki/Twelve_Apostles" title="Twelve Apostles">Twelve Apostles</a>, <a href="http://en.wikipedia.org/wiki/Jesus_and_the_Money_Changers" title="Jesus and the Money Changers">disturbance at Herod's Temple</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Mark%20&verse=11:15-19&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Mark%20&verse=11:15-19&src=31">Mark 11:15-19</a>, <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=John%20&verse=2:13-17&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=John%20&verse=2:13-17&src=31">John 2:13-17</a>), <a href="http://en.wikipedia.org/wiki/Crucified" title="Crucified">crucified</a> on <a href="http://en.wikipedia.org/wiki/Good_Friday" title="Good Friday">Friday</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Mark%20&verse=15:42&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Mark%20&verse=15:42&src=31">Mark 15:42</a>, <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=John%20&verse=19:42&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=John%20&verse=19:42&src=31">John 19:42</a>), <a href="http://en.wikipedia.org/wiki/Quartodeciman" title="Quartodeciman">Nisan 14th</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=%20John&verse=19:14&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=%20John&verse=19:14&src=31">John 19:14</a>, <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Mark%20&verse=14:2&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Mark%20&verse=14:2&src=31">Mark 14:2</a>, <a href="http://en.wikipedia.org/wiki/Gospel_of_Peter" title="Gospel of Peter">Gospel of Peter</a>) or Nisan 15th (<a href="http://en.wikipedia.org/wiki/Synoptic_Gospels" title="Synoptic Gospels">Synoptic Gospels</a>), (7Apr30, 3Apr33, 30Mar36, possible Fri-14-Nisan dates, -Meier), entombed by Pharisees <a href="http://en.wikipedia.org/wiki/Joseph_of_Arimathea" title="Joseph of Arimathea">Joseph of Arimathea</a> and <a href="http://en.wikipedia.org/wiki/Nicodemus" title="Nicodemus">Nicodemus</a> of the <a href="http://en.wikipedia.org/wiki/Sanhedrin" title="Sanhedrin">Sanhedrin</a>, <a href="http://en.wikipedia.org/wiki/Resurrection_of_Jesus" title="Resurrection of Jesus"> resurrected by God</a>, appeared to <a href="http://en.wikipedia.org/wiki/Paul_of_Tarsus" title="Paul of Tarsus">Paul of Tarsus</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=1Cor%20&verse=15:3-9&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=1Cor%20&verse=15:3-9&src=31">1Cor 15:3-9</a>), <a href="http://en.wikipedia.org/wiki/Simon_Peter" title="Simon Peter">Simon Peter</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Luke%20&verse=24:34&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Luke%20&verse=24:34&src=31">Luke 24:34</a>), <a href="http://en.wikipedia.org/wiki/Mary_Magdalene" title="Mary Magdalene">Mary Magdalene</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Mark%20&verse=16:9&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Mark%20&verse=16:9&src=31">Mark 16:9</a>, <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=John%20&verse=20:10-18&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=John%20&verse=20:10-18&src=31">John 20:10-18</a>), and others, <a href="http://en.wikipedia.org/wiki/Great_Commission" title="Great Commission">Great Commission</a>, <a href="http://en.wikipedia.org/wiki/Ascension" title="Ascension">Ascension</a>, prophecy of <a href="http://en.wikipedia.org/wiki/Second_Coming#Christianity" title="Second Coming">Second Coming</a>, see also <a href="http://en.wikipedia.org/wiki/Chronology_of_Jesus" title="Chronology of Jesus">Chronology of Jesus</a> </event>
<event namespace="Christianity" start="36" title="Jerusalem church founded"> <a href="http://en.wikipedia.org/wiki/Orthodox_Patriarch_of_Jerusalem#Bishops_of_Jerusalem_.2862_.E2.80.93_451.29" title="Orthodox Patriarch of Jerusalem">Jerusalem church</a> founded, first Christian <a href="http://en.wikipedia.org/wiki/Church" title="Church">church</a>, about 120 <a href="http://en.wikipedia.org/wiki/Jews" title="Jews">Jews</a> and Jewish <a href="http://en.wikipedia.org/wiki/Proselytes" title="Proselytes">Proselytes</a>, (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=1:15&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=1:15&src=31">Acts 1:15</a>), <a href="http://en.wikipedia.org/wiki/Pentacost" title="Pentacost">Pentacost</a>, <a href="http://en.wikipedia.org/wiki/Ananias_and_Sapphira" title="Ananias and Sapphira">Ananias and Sapphira</a> incident, Pharisee <a href="http://en.wikipedia.org/wiki/Gamaliel" title="Gamaliel">Gamaliel</a> spoke in defense of the <a href="http://en.wikipedia.org/wiki/Twelve_Apostles" title="Twelve Apostles">Apostles</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=5:34&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=5:34&src=31">Acts 5:34</a>), <a href="http://en.wikipedia.org/wiki/Saint_Stephen" title="Saint Stephen">Saint Stephen</a> <a href="http://en.wikipedia.org/wiki/Stoning" title="Stoning">stoned</a> (<a href="http://en.wikipedia.org/wiki/Persecution_of_Christians" title="Persecution of Christians">Persecution of Christians</a>) and the church dispersed (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=7:54-8:8&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=7:54-8:8&src=31">Acts 7:54-8:8</a>), <a href="http://en.wikipedia.org/wiki/Simon_Magus" title="Simon Magus">Simon Magus</a> baptized in <a href="http://en.wikipedia.org/wiki/Samaria" title="Samaria">Samaria</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=8:9-24&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=8:9-24&src=31">Acts 8:9-24</a>), <a href="http://en.wikipedia.org/wiki/Philip_the_Evangelist" title="Philip the Evangelist">Philip the Evangelist</a> baptized an <a href="http://en.wikipedia.org/wiki/Ethiopian" title="Ethiopian">Ethiopian</a> <a href="http://en.wikipedia.org/wiki/Eunuch" title="Eunuch">eunuch</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=8:26-40&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=8:26-40&src=31">Acts 8:26-40</a>) </event>
<event namespace="Christianity" start="37" title="Paul's Road to Damascus conversion"> Paul's <a href="http://en.wikipedia.org/wiki/Road_to_Damascus" title="Road to Damascus">Road to Damascus</a> conversion (<a href="http://en.wikipedia.org/wiki/Acts" title="Acts">Acts</a> <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=%20Acts&verse=9:3-19a&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=%20Acts&verse=9:3-19a&src=31">9:3-19a</a>; <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=%20Acts&verse=22:6-21&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=%20Acts&verse=22:6-21&src=31">22:6-21</a>; <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=%20Acts&verse=26:12-23&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=%20Acts&verse=26:12-23&src=31">26:12-23</a>) </event>
<event namespace="Christianity" start="40" title="First Gentile converts to Christianity"> <a href="http://en.wikipedia.org/wiki/Simon_Peter" title="Simon Peter">Simon Peter</a> <a href="http://en.wikipedia.org/wiki/Baptize" title="Baptize">baptized</a> Roman <a href="http://en.wikipedia.org/wiki/Centurion_Cornelius" title="Centurion Cornelius">Centurion Cornelius</a>, considered first <a href="http://en.wikipedia.org/wiki/Gentile" title="Gentile">Gentile</a> convert to Christianity (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=10&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=10&src=31">Acts 10</a>), <a href="http://en.wikipedia.org/wiki/List_of_Patriarchs_of_Antioch" title="List of Patriarchs of Antioch">Antioch church</a> founded, it was there that the term <a href="http://en.wikipedia.org/wiki/Christian" title="Christian">Christian</a> was first used (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=11:26&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=11:26&src=31">Acts 11:26</a>) </event>
<event namespace="Christianity" start="44" title="St. James the Great executed by Herod Agrippa"> <a href="http://en.wikipedia.org/wiki/Saint_James_the_Great" title="Saint James the Great">Saint James the Great</a>, brother of John, executed by <a href="http://en.wikipedia.org/wiki/Herod_Agrippa_I" title="Herod Agrippa I">Herod Agrippa I</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=12:1-3&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=12:1-3&src=31">Acts 12:1-3</a>) </event>
<event namespace="Christianity" start="45" end="49" isDuration="true" title="Paul's 1st mission"> Paul's 1st mission, (<a href="http://www.biblegateway.com/passage/?search=Acts%2013:1-14:27;&version=31;" class="external text" title="http://www.biblegateway.com/passage/?search=Acts%2013:1-14:27;&version=31;">Acts 13:1-14:27</a>), with <a href="http://en.wikipedia.org/wiki/Barnabas" title="Barnabas">Barnabas</a>, to Cyprus, Pisidian Antioch, Iconium, Lystra and Derbe (there they were called "gods ... in human form"), then return to Syrian <a href="http://en.wikipedia.org/wiki/Antioch" title="Antioch">Antioch</a> </event>
<event namespace="Christianity" start="49" title="Claudius expels Jews from Rome"> "Since the Jews constantly made disturbances at the instigation of Chrestus <span class="reference"><sup id="ref_RomeCrestus" class="plainlinksneverexpand"><a href="http://en.wikipedia.org/wiki/Timeline_of_Christianity#endnote_RomeCrestus" class="external autonumber" title="http://en.wikipedia.org/wiki/Timeline_of_Christianity#endnote_RomeCrestus">[1]</a></sup></span>, he <<a href="http://en.wikipedia.org/wiki/Claudius" title="Claudius">Claudius</a>> expelled them from Rome." (Suetonius,<a href="http://en.wikipedia.org/wiki/Lives_of_the_Twelve_Caesars" title="Lives of the Twelve Caesars">Lives of the Twelve Caesars</a>,Claudius XXV.4,<a href="http://en.wikipedia.org/wiki/Loeb_Classics" title="Loeb Classics">Loeb Classics</a>) (referenced in <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=18:2&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=18:2&src=31">Acts 18:2</a>) </event>
<event namespace="Christianity" start="50" title="Passover riot in Jerusalem"> <a href="http://en.wikipedia.org/wiki/Passover" title="Passover">Passover</a> riot in <a href="http://en.wikipedia.org/wiki/Jerusalem" title="Jerusalem">Jerusalem</a>, 20-30,000 killed (<a href="http://en.wikipedia.org/wiki/Antiquities_of_the_Jews" title="Antiquities of the Jews">JA</a>20.5.3,<a href="http://en.wikipedia.org/wiki/The_Wars_of_the_Jews" title="The Wars of the Jews">JW</a>2.12.1) </event>
<event namespace="Christianity" start="50" title="Council of Jerusalem"> <a href="http://en.wikipedia.org/wiki/Council_of_Jerusalem" title="Council of Jerusalem">Council of Jerusalem</a>, "Apostolic Decree" (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=15:1-35&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=15:1-35&src=31">Acts 15:1-35</a>) </event>
<event namespace="Christianity" start="50" end="53" isDuration="true" title="Paul's 2nd mission"> Paul's 2nd mission, (<a href="http://www.biblegateway.com/passage/?search=Acts%2015:36-18:22;&version=31;" class="external text" title="http://www.biblegateway.com/passage/?search=Acts%2015:36-18:22;&version=31;">Acts 15:36-18:22</a>), split with Barnabas, to Phrygia, Galatia, Macedonia, Philippi, Thessalonica, Berea, Athens, Corinth, "he had his hair cut off at Cenchrea because of a vow he had taken", then return to Antioch; <a href="http://en.wikipedia.org/wiki/First_Epistle_to_the_Thessalonians" title="First Epistle to the Thessalonians">1 Thessalonians</a>, <a href="http://en.wikipedia.org/wiki/Epistle_to_Galatians" title="Epistle to Galatians">Galatians</a> written? </event>
<event namespace="Christianity" start="52" title="St. Thomas Christians of India"> 52? <a href="http://en.wikipedia.org/wiki/Saint_Thomas_Christians" title="Saint Thomas Christians">Saint Thomas Christians</a> of India </event>
<event namespace="Christianity" start="53" end="57" isDuration="true" title="Paul's 3rd mission"> Paul's 3rd mission, (<a href="http://www.biblegateway.com/passage/?search=Acts%2018:23-21:26;&version=31;" class="external text" title="http://www.biblegateway.com/passage/?search=Acts%2018:23-21:26;&version=31;">Acts 18:23-21:26</a>), to Galatia, Phrygia, Corinth, Ephesus, Macedonia, Greece, Jerusalem, there <a href="http://en.wikipedia.org/wiki/James_the_Just" title="James the Just">James the Just</a> challenged him about rumor of teaching <a href="http://en.wikipedia.org/wiki/Antinomianism" title="Antinomianism">antinomianism</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=21:21&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=21:21&src=31">Acts 21:21</a>), he addressed a crowd in their language (most likely <a href="http://en.wikipedia.org/wiki/Aramaic_of_Jesus" title="Aramaic of Jesus">Aramaic</a>) (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=22&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=22&src=31">Acts 22</a>), <a href="http://en.wikipedia.org/wiki/Epistle_to_the_Romans" title="Epistle to the Romans">Romans</a>, <a href="http://en.wikipedia.org/wiki/First_Epistle_to_the_Corinthians" title="First Epistle to the Corinthians">1 Corinthians</a>, <a href="http://en.wikipedia.org/wiki/Second_Epistle_to_the_Corinthians" title="Second Epistle to the Corinthians">2 Corinthians</a>, <a href="http://en.wikipedia.org/wiki/Epistle_to_the_Philippians" title="Epistle to the Philippians">Philippians</a> written? </event>
<event namespace="Christianity" start="55" title="Exodus reenactment massacred by Procurator"> "Egyptian Prophet" and 30,000 unarmed Jews doing <a href="http://en.wikipedia.org/wiki/The_Exodus" title="The Exodus">The Exodus</a> reenactment massacred by <a href="http://en.wikipedia.org/wiki/Procurator" title="Procurator">Procurator</a> <a href="http://en.wikipedia.org/wiki/Antonius_Felix" title="Antonius Felix">Antonius Felix</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=21:38&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=21:38&src=31">Acts 21:38</a>, JW2.261, JA20.169) </event>
<event namespace="Christianity" start="58" title="Paul arrested"> Paul arrested, accused of being a <a href="http://en.wikipedia.org/wiki/Zealot" title="Zealot">revolutionary</a>, "ringleader of the sect of the <a href="http://en.wikipedia.org/wiki/Nazarenes" title="Nazarenes">Nazarenes</a>", teaching <a href="http://en.wikipedia.org/wiki/Resurrection" title="Resurrection">resurrection</a> of the dead, imprisoned in <a href="http://en.wikipedia.org/wiki/Caesarea_Palaestina" title="Caesarea Palaestina">Caesarea</a> (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=23-26&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=23-26&src=31">Acts 23-26</a>) </event>
<event namespace="Christianity" start="59" title="Paul shipwrecked on Malta"> Paul shipwrecked on <a href="http://en.wikipedia.org/wiki/Malta" title="Malta">Malta</a>, there he was called a god (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=28:6&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=28:6&src=31">Acts 28:6</a>) </event>
<event namespace="Christianity" start="60" title="Paul in Rome"> Paul in Rome: greeted by many "brothers", three days later called together the Jewish leaders, who hadn't received any word from Judea about him, but were curious about "this sect", which everywhere is spoken against; he tried to convince them from the "<a href="http://en.wikipedia.org/wiki/Torah" title="Torah">Law</a> and <a href="http://en.wikipedia.org/wiki/Neviim" title="Neviim">Prophets</a>", with partial success, said the Gentiles would listen and spent two years proclaiming the "Lord Jesus Christ" (<a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=Acts%20&verse=28:15-31&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=Acts%20&verse=28:15-31&src=31">Acts 28:15-31</a>); <a href="http://en.wikipedia.org/wiki/Epistle_to_Philemon" title="Epistle to Philemon">Epistle to Philemon</a> written? </event>
<event namespace="Christianity" start="62" title="James the Just stoned to death"> James the Just stoned to death for law transgression by <a href="http://en.wikipedia.org/wiki/List_of_High_Priests_of_Israel" title="List of High Priests of Israel">High Priest</a> Ananus ben Artanus, popular opinion against act results in Ananus being deposed by new procurator <a href="http://en.wikipedia.org/wiki/Clodius_Albinus" title="Clodius Albinus">Clodius Albinus</a> (<a href="http://en.wikipedia.org/wiki/Jewish_Antiquities" title="Jewish Antiquities">JA</a>20.9.1) </event>
<event namespace="Christianity" start="63" end="107" isDuration="true" title="Simeon of Jerusalem"> <a href="http://en.wikipedia.org/wiki/Simeon_of_Jerusalem" title="Simeon of Jerusalem">Simeon</a>, 2nd <a href="http://en.wikipedia.org/wiki/Orthodox_Patriarch_of_Jerusalem#Bishops_of_Jerusalem_.2862_.E2.80.93_451.29" title="Orthodox Patriarch of Jerusalem">Bishop of Jerusalem</a>, crucified under <a href="http://en.wikipedia.org/wiki/Trajan" title="Trajan">Trajan</a> </event>
<event namespace="Christianity" start="63" title="Glastonbury Abbey founded"> <a href="http://en.wikipedia.org/wiki/Glastonbury_Abbey" title="Glastonbury Abbey">Glastonbury Abbey</a> founded according to tradition, but date disputed </event>
<event namespace="Christianity" start="64" end="68" isDuration="true" title="Great Fire of Rome, Nero blamed, persecuted"> 64-68 after July 18 <a href="http://en.wikipedia.org/wiki/Great_Fire_of_Rome" title="Great Fire of Rome">Great Fire of Rome</a>, <a href="http://en.wikipedia.org/wiki/Nero" title="Nero">Nero</a> blamed and <a href="http://en.wikipedia.org/wiki/Persecution_of_Christians" title="Persecution of Christians">persecuted</a> the <i>Christians</i>, earliest mention of <i>Christians</i>, by that name, in Rome, see also <a href="http://en.wikipedia.org/wiki/Tacitus_on_Jesus" title="Tacitus on Jesus">Tacitus on Jesus</a>, Paul beheaded? (Col1:24, Eph3:13, 2Tm4:6-8, 1Clem5:5-7), Peter crucified upside down? (Jn21:18,1Pt5:13,Origen), "...a vast multitude, were convicted, not so much of the crime of incendiarism as of hatred of the human race. And in their deaths they were made the subjects of sport; for they were wrapped in the hides of wild beasts and torn to pieces by dogs, or nailed to crosses, or set on fire, and when day declined, were burned to serve for nocturnal lights." (<a href="http://en.wikipedia.org/wiki/Annals_%28Tacitus%29" title="Annals (Tacitus)">Annals (Tacitus)</a> XV.44) </event>
<event namespace="Christianity" start="65" title="Q document"> <a href="http://en.wikipedia.org/wiki/Q_document" title="Q document">Q document</a>, a hypothetical Greek text thought by many critical scholars to have been used in writing of <a href="http://en.wikipedia.org/wiki/Gospel_of_Matthew" title="Gospel of Matthew">Matthew</a> and <a href="http://en.wikipedia.org/wiki/Gospel_of_Luke" title="Gospel of Luke">Luke</a> </event>
<event namespace="Christianity" start="66" end="73" isDuration="true" title="Great Jewish Revolt"> <a href="http://en.wikipedia.org/wiki/Great_Jewish_Revolt" title="Great Jewish Revolt">Great Jewish Revolt</a>: destruction of <a href="http://en.wikipedia.org/wiki/Herod%27s_Temple" title="Herod's Temple">Herod's Temple</a>, <a href="http://en.wikipedia.org/wiki/Qumran" title="Qumran">Qumran</a> community destroyed, site of <a href="http://en.wikipedia.org/wiki/Dead_Sea_Scrolls" title="Dead Sea Scrolls">Dead Sea Scrolls</a> found in 1947 </event>
<event namespace="Christianity" start="68" end="107?" isDuration="true" title="Ignatius of Antioch fed to lions in Rome"> <a href="http://en.wikipedia.org/wiki/Ignatius_of_Antioch" title="Ignatius of Antioch">Ignatius</a>, third <a href="http://en.wikipedia.org/wiki/Bishop_of_Antioch" title="Bishop of Antioch">Bishop of Antioch</a>, fed to the lions in Rome, advocated the <a href="http://en.wikipedia.org/wiki/Bishop" title="Bishop">Bishop</a>, rejected <a href="http://en.wikipedia.org/wiki/Sabbath" title="Sabbath">Sabbath</a>?, his letters were subjected to heavy Christian forgery especially 4th century (Apostolic Fathers) </event>
<event namespace="Christianity" start="60" end="80" title="Gospel of Mark"> <a href="http://en.wikipedia.org/wiki/Gospel_of_Mark" title="Gospel of Mark">Gospel of Mark</a>, written in Rome?, by Peter's interpreter? (1 Peter 5:13), original ending apparently lost, endings added c.400, see <a href="http://en.wikipedia.org/wiki/Mark_16" title="Mark 16">Mark 16</a> </event>
<event namespace="Christianity" start="70" title="Signs Gospel"> <a href="http://en.wikipedia.org/wiki/Signs_Gospel" title="Signs Gospel">Signs Gospel</a> written, hypothetical Greek text used in Gospel of John to prove Jesus is the Messiah </event>
<event namespace="Christianity" start="70" end="100" isDuration="true" title="Pauline Epistles"> <a href="http://en.wikipedia.org/wiki/Pauline_Epistles" title="Pauline Epistles">Pauline Epistles</a> </event>
<event namespace="Christianity" start="70" end="200" isDuration="true" title="Other Gospels"> 70-200? <a href="http://en.wikipedia.org/wiki/Didache" title="Didache">Didache</a>; Other Gospels: <a href="http://en.wikipedia.org/wiki/Unknown_Berlin_Gospel" title="Unknown Berlin Gospel">Unknown Berlin Gospel</a>, <a href="http://en.wikipedia.org/wiki/Gospel_of_Peter" title="Gospel of Peter">Gospel of Peter</a>, <a href="http://en.wikipedia.org/wiki/Gospel_of_Thomas" title="Gospel of Thomas">Gospel of Thomas</a>, <a href="http://en.wikipedia.org/wiki/Oxyrhynchus_Gospels" title="Oxyrhynchus Gospels">Oxyrhynchus Gospels</a>, <a href="http://en.wikipedia.org/wiki/Egerton_Gospel" title="Egerton Gospel">Egerton Gospel</a>, <a href="http://en.wikipedia.org/wiki/Fayyum_Fragment" title="Fayyum Fragment">Fayyum Fragment</a>, <a href="http://en.wikipedia.org/wiki/Dialogue_of_the_Saviour" title="Dialogue of the Saviour">Dialogue of the Saviour</a>; <a href="http://en.wikipedia.org/wiki/Jewish_Christian" title="Jewish Christian">Jewish Christian</a> Gospels: <a href="http://en.wikipedia.org/wiki/Gospel_of_the_Ebionites" title="Gospel of the Ebionites">Gospel of the Ebionites</a>, <a href="http://en.wikipedia.org/wiki/Gospel_of_the_Hebrews" title="Gospel of the Hebrews">Gospel of the Hebrews</a>, <a href="http://en.wikipedia.org/wiki/Gospel_of_the_Nazarenes" title="Gospel of the Nazarenes">Gospel of the Nazarenes</a> </event>
<event namespace="Christianity" start="60" end="100" title="Gospel of Matthew"> <a href="http://en.wikipedia.org/wiki/Gospel_of_Matthew" title="Gospel of Matthew">Gospel of Matthew</a>, based on Mark and Q, most popular in <a href="http://en.wikipedia.org/wiki/Early_Christianity" title="Early Christianity">Early Christianity</a> </event>
<event namespace="Christianity" start="60" end="100" title="Gospel of Luke"> <a href="http://en.wikipedia.org/wiki/Gospel_of_Luke" title="Gospel of Luke">Gospel of Luke</a>, based on Mark and Q, also <a href="http://en.wikipedia.org/wiki/Acts_of_the_Apostles" title="Acts of the Apostles">Acts of the Apostles</a> by same author </event>
<event namespace="Christianity" start="88" end="101" isDuration="true" title="Letter to the Corinthians"> <a href="http://en.wikipedia.org/wiki/Pope_Clement_I" title="Pope Clement I">Clement I, Bishop of Rome</a>, wrote <a href="http://en.wikipedia.org/wiki/Epistles_of_Clement" title="Epistles of Clement">Letter of the Romans to the Corinthians</a> (Apostolic Fathers) </event>
<event namespace="Christianity" start="90" title="Council of Jamnia"> 90? <a href="http://en.wikipedia.org/wiki/Council_of_Jamnia" title="Council of Jamnia">Council of Jamnia</a> of <a href="http://en.wikipedia.org/wiki/Judaism" title="Judaism">Judaism</a> (disputed) </event>
<event namespace="Christianity" start="80" end="100" title="1 Peter"> <a href="http://en.wikipedia.org/wiki/1_Peter" title="1 Peter">1 Peter</a> </event>
<event namespace="Christianity" start="94" title="Testimonium Flavianum"> <a href="http://en.wikipedia.org/wiki/Testimonium_Flavianum" title="Testimonium Flavianum">Testimonium Flavianum</a>, disputed section of <a href="http://en.wikipedia.org/wiki/Jewish_Antiquities" title="Jewish Antiquities">Jewish Antiquities</a> by <a href="http://en.wikipedia.org/wiki/Josephus" title="Josephus">Josephus</a> in <a href="http://en.wikipedia.org/wiki/Aramaic_language" title="Aramaic language">Aramaic</a>, translated to <a href="http://en.wikipedia.org/wiki/Koine_Greek" title="Koine Greek">Koine Greek</a> </event>
<event namespace="Christianity" start="65" end="125" title="Gospel of John"> <a href="http://en.wikipedia.org/wiki/Gospel_of_John" title="Gospel of John">Gospel of John</a> and <a href="http://en.wikipedia.org/wiki/Epistles_of_John" title="Epistles of John">Epistles of John</a> </event>
<event namespace="Christianity" start="85" end="105" title="Book of Revelation"> <a href="http://en.wikipedia.org/wiki/Book_of_Revelation" title="Book of Revelation">Book of Revelation</a> written, by John (son of Zebedee) and/or a disciple of his </event>
<event namespace="Christianity" start="70" end="130" title="Epistle of Barnabas"> <a href="http://en.wikipedia.org/wiki/Epistle_of_Barnabas" title="Epistle of Barnabas">Epistle of Barnabas</a> (Apostolic Fathers) </event>
<event namespace="Christianity" start="75" end="125" title="Epistle of James"> <a href="http://en.wikipedia.org/wiki/Epistle_of_James" title="Epistle of James">Epistle of James</a> </event>
<event namespace="Christianity" start="90" end="110" title="Epistle of Jude"> <a href="http://en.wikipedia.org/wiki/Epistle_of_Jude" title="Epistle of Jude">Epistle of Jude</a> written, probably by doubting relative of Jesus (Mark 6,3), rejected by some early Christians due to its reference to apocryphal <a href="http://en.wikipedia.org/wiki/Book_of_Enoch" title="Book of Enoch">Book of Enoch</a> (v14), <a href="http://en.wikipedia.org/wiki/Epistle_to_the_Hebrews" title="Epistle to the Hebrews">Epistle to the Hebrews</a> written </event>
<event namespace="Christianity" start="100" end="150" isDuration="true" title="Apocryphon of James"> 100-150? <a href="http://en.wikipedia.org/wiki/Apocryphon_of_James" title="Apocryphon of James">Apocryphon of James</a>, <a href="http://en.wikipedia.org/wiki/Gospel_of_Mary_Magdalene" title="Gospel of Mary Magdalene">Gospel of Mary Magdalene</a>, <a href="http://en.wikipedia.org/wiki/Gospel_of_James" title="Gospel of James">Gospel of James</a>, <a href="http://en.wikipedia.org/wiki/Infancy_Gospel_of_Thomas" title="Infancy Gospel of Thomas">Infancy Gospel of Thomas</a>, <a href="http://en.wikipedia.org/wiki/Secret_Gospel_of_Mark" title="Secret Gospel of Mark">Secret Gospel of Mark</a> (<i>Complete Gospels</i>, published by <a href="http://en.wikipedia.org/wiki/Jesus_Seminar" title="Jesus Seminar">Jesus Seminar</a>) </event>
<event namespace="Christianity" start="110" end="130" isDuration="true" title="Expositions of Sayings of the Lord"> <a href="http://en.wikipedia.org/wiki/Papias" title="Papias">Papias</a>, bishop of <a href="http://en.wikipedia.org/wiki/Pamukkale" title="Pamukkale">Hierapolis</a>, wrote: "Expositions of the Sayings of the Lord", lost, widely quoted (Apostolic Fathers) </event>
<event namespace="Christianity" start="110" end="160" isDuration="true" title="Letter to the Philippians"> 110-160? <a href="http://en.wikipedia.org/wiki/Polycarp" title="Polycarp">Polycarp</a>, bishop of <a href="http://en.wikipedia.org/wiki/Izmir" title="Izmir">Smyrna</a>, <a href="http://en.wikipedia.org/wiki/Polycarp%27s_letter_to_the_Philippians" title="Polycarp's letter to the Philippians">Letter to the Philippians</a>, (Apostolic Fathers) </event>
<event namespace="Christianity" start="120" end="130" title="2 Peter"> 125(+/-5)? <a href="http://en.wikipedia.org/wiki/2_Peter" title="2 Peter">2 Peter</a> written, not accepted into canon until early 400s, drew upon Epistle of Jude, "catholic" epistle, <a href="http://en.wikipedia.org/wiki/Pastoral_Epistles" title="Pastoral Epistles">Pastoral Epistles</a> written </event>
<event namespace="Christianity" start="125" title="Rylands Library Papyrus P52"> <a href="http://en.wikipedia.org/wiki/Rylands_Library_Papyrus_P52" title="Rylands Library Papyrus P52">Rylands Library Papyrus P52</a>, oldest extant NT fragment, p.1935, parts of Jn18:31-33,37-38 </event>
<event namespace="Christianity" start="130" end="250" isDuration="true" title="Christian Apologists"> "Christian Apologists" writings against <a href="http://en.wikipedia.org/wiki/Roman_religion" title="Roman religion">Roman religion</a>: <a href="http://en.wikipedia.org/wiki/Justin_Martyr" title="Justin Martyr">Justin Martyr</a>, <a href="http://en.wikipedia.org/wiki/Athenagoras_of_Athens" title="Athenagoras of Athens">Athenagoras</a>, <a href="http://en.wikipedia.org/wiki/Apology_of_Aristides" title="Apology of Aristides">Apology of Aristides</a>, <a href="http://en.wikipedia.org/wiki/Theophilus_of_Antioch" title="Theophilus of Antioch">Theophilus of Antioch</a>, <a href="http://en.wikipedia.org/wiki/Tatian" title="Tatian">Tatian</a>, <a href="http://en.wikipedia.org/wiki/Quadratus_%28apostle%29" title="Quadratus (apostle)">Quadratus</a>, <a href="http://en.wikipedia.org/wiki/Melito_of_Sardis" title="Melito of Sardis">Melito of Sardis</a>, <a href="http://en.wikipedia.org/wiki/Apollinaris_Claudius" title="Apollinaris Claudius">Apollinaris Claudius</a>, <a href="http://en.wikipedia.org/wiki/Felix_Marcus_Minucius" title="Felix Marcus Minucius">Felix Marcus Minucius</a>, <a href="http://en.wikipedia.org/wiki/Arnobius" title="Arnobius">Arnobius</a>, <a href="http://en.wikipedia.org/wiki/Epistle_to_Diognetus" title="Epistle to Diognetus">Epistle to Diognetus</a> </event>
<event namespace="Christianity" start="132" end="135" isDuration="true" title="Bar Kokhba's revolt"> <a href="http://en.wikipedia.org/wiki/Bar_Kokhba%27s_revolt" title="Bar Kokhba's revolt">Bar Kokhba's revolt</a>: final Jewish revolt, Judea and Jerusalem erased from maps, all of southern <a href="http://en.wikipedia.org/wiki/Syria" title="Syria">Syria</a> renamed <a href="http://en.wikipedia.org/wiki/Syria_Pal%C3%A6stina" title="Syria Palæstina">Palestine</a> (coined by <a href="http://en.wikipedia.org/wiki/Herodotus" title="Herodotus">Herodotus</a>) </event>
<event namespace="Christianity" start="142" end="144" isDuration="true" title="Marcionism"> 142-144? <a href="http://en.wikipedia.org/wiki/Marcion_of_Sinope" title="Marcion of Sinope">Marcion of Sinope</a>, bishop according to <a href="http://en.wikipedia.org/wiki/Catholic_Encyclopedia" title="Catholic Encyclopedia">Catholic Encyclopedia</a>, went to Rome, possibly to <a href="http://en.wikipedia.org/wiki/Simony" title="Simony">buy the bishropic of Rome</a>, upon rejection formed his own church in Rome, later called <a href="http://en.wikipedia.org/wiki/Marcionism" title="Marcionism">Marcionism</a>, rejected <a href="http://en.wikipedia.org/wiki/Old_Testament" title="Old Testament">Old Testament</a>, decreed <a href="http://en.wikipedia.org/wiki/Biblical_canon" title="Biblical canon">canon</a> of one <a href="http://en.wikipedia.org/wiki/Gospel_of_Marcion" title="Gospel of Marcion">Gospel</a>, one <i>Apostolicon</i> (10 Letters of Paul) and one <i>Antithesis</i><a href="http://www.gnosis.org/library/marcion/antithes.htm" class="external autonumber" title="http://www.gnosis.org/library/marcion/antithes.htm">[2]</a> which contrasted the Old Testament with the <a href="http://en.wikipedia.org/wiki/New_Testament" title="New Testament">New Testament</a>, cited <a href="http://en.wikipedia.org/wiki/Western_text-type" title="Western text-type">Western text-type</a> </event>
<event namespace="Christianity" start="150" title="Acts of the Apostles revised"> "Western Revisor" adds/subtracts from original Acts to produce <a href="http://en.wikipedia.org/wiki/Acts_of_the_Apostles#Text" title="Acts of the Apostles">Western</a> version which is 10% larger and found in Papyrus P29,38,48 and <a href="http://en.wikipedia.org/wiki/Codex_Bezae" title="Codex Bezae">Codex Bezae</a> (D) </event>
<event namespace="Christianity" start="150" title="Valentinius lost election for Bishop of Rome"> <a href="http://en.wikipedia.org/wiki/Valentinius" title="Valentinius">Valentinius</a>, most famous Christian <a href="http://en.wikipedia.org/wiki/Gnostic" title="Gnostic">Gnostic</a>, according to <a href="http://en.wikipedia.org/wiki/Tertullian" title="Tertullian">Tertullian</a> narrowly lost election for Bishop of Rome </event>
<event namespace="Christianity" start="140" end="160" title="Shepherd of Hermas"> <a href="http://en.wikipedia.org/wiki/Shepherd_of_Hermas" title="Shepherd of Hermas">Shepherd of Hermas</a>, written in Rome (Apostolic Fathers) </event>
<event namespace="Christianity" start="155" title="Montanus"> <a href="http://en.wikipedia.org/wiki/Montanus" title="Montanus">Montanus</a>, claimed to be the <a href="http://en.wikipedia.org/wiki/Paraclete" title="Paraclete">Paraclete</a> ("Counselor") of <a href="http://php.ug.cs.usyd.edu.au/%7Ejnot4610/bibref.php?book=%20John&verse=14:16&src=31" class="external text" title="http://php.ug.cs.usyd.edu.au/~jnot4610/bibref.php?book=%20John&verse=14:16&src=31">John 14:16</a> </event>
<event namespace="Christianity" start="160" title="Martyrdom of Polycarp"> <a href="http://en.wikipedia.org/wiki/Martyrdom_of_Polycarp" title="Martyrdom of Polycarp">Martyrdom of Polycarp</a> (Apostolic Fathers) </event>
<event namespace="Christianity" start="170" title="Bishop of Corinth fakes letters"> Dionysius<a href="http://www.newadvent.org/cathen/05010a.htm" class="external autonumber" title="http://www.newadvent.org/cathen/05010a.htm">[3]</a>, bishop of Corinth, claimed Christians were changing and faking his own letters just as [he knew] they had changed the Gospels (<a href="http://en.wikipedia.org/wiki/Eusebius" title="Eusebius">EH</a>4.23.12;<a href="http://en.wikipedia.org/wiki/Ante-Nicene_Fathers" title="Ante-Nicene Fathers">Ante-Nicene Fathers</a>,v.8) </event>
<event namespace="Christianity" start="170" title="Diatessaron"> <a href="http://en.wikipedia.org/wiki/Tatian" title="Tatian">Tatian</a> produces "<a href="http://en.wikipedia.org/wiki/Diatessaron" title="Diatessaron">Diatessaron</a>" (Harmony) by blending 4 "Western" text-type Gospels into 1 </event>
<event namespace="Christianity" start="170" title="Symmachus the Ebionite"> <a href="http://en.wikipedia.org/wiki/Symmachus_the_Ebionite" title="Symmachus the Ebionite">Symmachus the Ebionite</a>, new Greek translation of <a href="http://en.wikipedia.org/wiki/Hebrew_Bible" title="Hebrew Bible">Hebrew Bible</a> </event>
<event namespace="Christianity" start="180" title="Hegesippus"> <a href="http://en.wikipedia.org/wiki/Hegesippus" title="Hegesippus">Hegesippus</a> </event>
<event namespace="Christianity" start="180" end="202" isDuration="true" title="Bishop of Lyon combats heresies"> <a href="http://en.wikipedia.org/wiki/Irenaeus" title="Irenaeus">Irenaeus</a>, <a href="http://en.wikipedia.org/wiki/Bishop_of_Lyon" title="Bishop of Lyon">Bishop of Lyon</a>, combated heresies, cited "Western" Gospel text-type (Ante-Nicene Fathers) </event>
<event namespace="Christianity" start="185" end="350" isDuration="true" title="Muratorian fragment"> <a href="http://en.wikipedia.org/wiki/Muratorian_fragment" title="Muratorian fragment">Muratorian fragment</a>, 1st extant canon for <a href="http://en.wikipedia.org/wiki/New_Testament" title="New Testament">New Testament</a> after Marcion?, written in Rome by <a href="http://en.wikipedia.org/wiki/Hippolytus_%28writer%29" title="Hippolytus (writer)">Hippolytus</a>?, excludes Hebrews, James, 1-2 Peter, 3 John; includes <a href="http://en.wikipedia.org/wiki/Wisdom_of_Solomon" title="Wisdom of Solomon">Wisdom of Solomon</a>, <a href="http://en.wikipedia.org/wiki/Apocalypse_of_Peter" title="Apocalypse of Peter">Apocalypse of Peter</a> </event>
<event namespace="Christianity" start="186" title="'Catholic' used"> <a href="http://en.wikipedia.org/wiki/Saint_Apollonius" title="Saint Apollonius">Saint Apollonius</a>, used the term <i>catholic</i> in reference to 1 John </event>
<event namespace="Christianity" start="188" end="231" isDuration="true" title="Saint Demetrius condemned"> <a href="http://en.wikipedia.org/wiki/Saint_Demetrius" title="Saint Demetrius">Saint Demetrius</a>, bishop of Alexandria, condemned <a href="http://en.wikipedia.org/wiki/Origen" title="Origen">Origen</a> </event>
<event namespace="Christianity" start="189" end="198" isDuration="true" title="Pope Victor excommunicates Extern churches"> <a href="http://en.wikipedia.org/wiki/Pope_Victor_I" title="Pope Victor I">Pope Victor I</a>, 1st <a href="http://en.wikipedia.org/wiki/Latin" title="Latin">Latin</a> Pope, excommunicated Eastern churches that continued to observe <a href="http://en.wikipedia.org/wiki/Easter" title="Easter">Easter</a> on Nisan 14 <a href="http://en.wikipedia.org/wiki/Quartodeciman" title="Quartodeciman">Quartodeciman</a> </event>
<event namespace="Christianity" start="196" title="Polycrates of Ephesus"> <a href="http://en.wikipedia.org/wiki/Polycrates_of_Ephesus" title="Polycrates of Ephesus">Polycrates</a>, bishop of Ephesus (Ante-Nicene Fathers) </event>
<event namespace="Christianity" start="199" end="217" isDuration="true" title="Dialogue against Proclus"> Caius<a href="http://www.newadvent.org/cathen/03144a.htm" class="external autonumber" title="http://www.newadvent.org/cathen/03144a.htm">[4]</a>, <a href="http://en.wikipedia.org/wiki/Presbyter" title="Presbyter">presbyter</a> of Rome, wrote "Dialogue against Proclus" in <a href="http://en.wikipedia.org/wiki/Ante-Nicene_Fathers" title="Ante-Nicene Fathers">Ante-Nicene Fathers</a>, rejected <a href="http://en.wikipedia.org/wiki/Revelation" title="Revelation">Revelation</a>, said to be by Gnostic <a href="http://en.wikipedia.org/wiki/Cerinthus" title="Cerinthus">Cerinthus</a> </event>
<event namespace="Christianity" start="200" title="Papyrus 46"> <a href="http://en.wikipedia.org/wiki/Papyrus_46" title="Papyrus 46">Papyrus 46</a>: 2nd <a href="http://en.wikipedia.org/wiki/Chester_Beatty" title="Chester Beatty">Chester Beatty</a>, <a href="http://en.wikipedia.org/wiki/Alexandrian_text-type" title="Alexandrian text-type">Alexandrian text-type</a>; Papyrus 66: 2nd Bodmer, John, 1956, "Alexandrian/Western" text-types; Papyrus 75: Bodmer 14-15, Luke & John, earliest extant Luke, ~Vaticanus; 200? Papyrus 32: J. Rylands Library: Titus 1:11-15;2:3-8; Papyrus 64 (+67): Mt3:9,15; 5:20-22,25-28; 26:7-8,10,14-15,22-23,31-33 </event>
<event namespace="Christianity" start="200" title="Sextus Julius Africanus"> <a href="http://en.wikipedia.org/wiki/Sextus_Julius_Africanus" title="Sextus Julius Africanus">Sextus Julius Africanus</a> </event>
<event namespace="Christianity" start="200" title="Antipope Natalius"> <a href="http://en.wikipedia.org/wiki/Antipope" title="Antipope">Antipope</a> Natalius<a href="http://www.newadvent.org/cathen/10448a.htm" class="external autonumber" title="http://www.newadvent.org/cathen/10448a.htm">[5]</a>, rival bishop of Rome, according to <a href="http://en.wikipedia.org/wiki/Eusebius" title="Eusebius">Eusebius</a>'s EH5.28.8-12, quoting the <i>Little Labyrinth</i> of <a href="http://en.wikipedia.org/wiki/Hippolytus_%28writer%29" title="Hippolytus (writer)">Hippolytus</a>, after being "<a href="http://en.wikipedia.org/wiki/Scourge" title="Scourge">scourged</a> all night by the holy angels", covered in ash, dressed in <a href="http://en.wikipedia.org/wiki/Sackcloth" title="Sackcloth">sackcloth</a>, and "after some difficulty", tearfully submitted to <a href="http://en.wikipedia.org/wiki/Pope_Zephyrinus" title="Pope Zephyrinus">Pope Zephyrinus</a> </event>
<event namespace="Christianity" start="217" end="236" isDuration="true" title="Antipope Hippolytus"> <a href="http://en.wikipedia.org/wiki/Antipope_Hippolytus" title="Antipope Hippolytus">Antipope Hippolytus</a>, <i>Logos</i> sect? </event>
<event namespace="Christianity" start="218" end="258" isDuration="true" title="Bishop of Carthage claims Christians forge his letters"> <a href="http://en.wikipedia.org/wiki/Cyprian" title="Cyprian">Cyprian</a>, Bishop of <a href="http://en.wikipedia.org/wiki/Carthage" title="Carthage">Carthage</a>, cited "Western" NT text-type, claimed Christians were freely forging his letters to discredit him (Ante-Nicene Fathers) </event>
<event namespace="Christianity" start="220" title="Secret Gospel of Mark"> <a href="http://en.wikipedia.org/wiki/Clement_of_Alexandria" title="Clement of Alexandria">Clement of Alexandria</a>, cited "Alexandrian" NT text-type & <a href="http://en.wikipedia.org/wiki/Secret_Gospel_of_Mark" title="Secret Gospel of Mark">Secret Gospel of Mark</a> & <a href="http://en.wikipedia.org/wiki/Gospel_of_the_Egyptians" title="Gospel of the Egyptians">Gospel of the Egyptians</a>; wrote: "Exhortations to the Greeks"; "Rich Man's Salutation"; "To the Newly Baptized"; (Ante-Nicene Fathers) </event>
<event namespace="Christianity" start="220" end="340" isDuration="true" title="Gospel of Judas"> <a href="http://en.wikipedia.org/wiki/Codex_Tchacos" title="Codex Tchacos">Codex Tchacos</a>, manuscript containing a copy of the <a href="http://en.wikipedia.org/wiki/Gospel_of_Judas" title="Gospel of Judas">Gospel of Judas</a> has been written. </event>
<event namespace="Christianity" start="223" title="Tertullian"> <a href="http://en.wikipedia.org/wiki/Tertullian" title="Tertullian">Tertullian</a>, sometimes called "father of the Latin Church" because he coined <a href="http://en.wikipedia.org/wiki/Trinity" title="Trinity">trinitas</a>, tres <a href="http://en.wikipedia.org/wiki/Persona" title="Persona">Personae</a>, <a href="http://en.wikipedia.org/wiki/Consubstantial" title="Consubstantial">una Substantia</a>, <a href="http://en.wikipedia.org/wiki/Old_Testament" title="Old Testament">Vetus Testamentum</a>, <a href="http://en.wikipedia.org/wiki/New_Testament" title="New Testament">Novum Testamentum</a>, convert to <a href="http://en.wikipedia.org/wiki/Montanism" title="Montanism">Montanism</a>, cited "Western" Gospel text-type (Ante-Nicene Fathers) </event>
<event namespace="Christianity" start="225" title="Papyrus 45"> Papyrus 45: 1st Chester Beatty, Gospels (<a href="http://en.wikipedia.org/wiki/Caesarean_text-type" title="Caesarean text-type">Caesarean text-type</a>), Acts (Alexandrian test-type) </event>
<event namespace="Christianity" start="235" end="238" isDuration="true" title="Rome deports Pope Pontian"> <a href="http://en.wikipedia.org/wiki/Maximinus_Thrax" title="Maximinus Thrax">Maximinus Thrax</a>, emperor of Rome, ends Christian schism in Rome by deporting <a href="http://en.wikipedia.org/wiki/Pope_Pontian" title="Pope Pontian">Pope Pontian</a> and <a href="http://en.wikipedia.org/wiki/Antipope_Hippolytus" title="Antipope Hippolytus">Antipope Hippolytus</a> to <a href="http://en.wikipedia.org/wiki/Sardinia" title="Sardinia">Sardinia</a> where they soon die </event>
<event namespace="Christianity" start="248" end="264" isDuration="true" title="Dionysius of Alexandria"> <a href="http://en.wikipedia.org/wiki/Dionysius_of_Alexandria" title="Dionysius of Alexandria">Dionysius</a>, <a href="http://en.wikipedia.org/wiki/Patriarch_of_Alexandria" title="Patriarch of Alexandria">Patriarch of Alexandria</a> see also <a href="http://en.wikipedia.org/wiki/List_of_Patriarchs_of_Alexandria" title="List of Patriarchs of Alexandria">List of Patriarchs of Alexandria</a> </event>
<event namespace="Christianity" start="250" title="Apostolic Constitutions"> <a href="http://en.wikipedia.org/wiki/Apostolic_Constitutions" title="Apostolic Constitutions">Apostolic Constitutions</a>, <a href="http://en.wikipedia.org/wiki/Liturgy_of_St_James" title="Liturgy of St James">Liturgy of St James</a>, <a href="http://en.wikipedia.org/wiki/Apostles%27_Creed" title="Apostles' Creed">Apostles' Creed</a>, <a href="http://en.wikipedia.org/wiki/Clementine_literature" title="Clementine literature">Clementine literature</a> </event>
<event namespace="Christianity" start="250" title="Methodius of Olympus"> Letters of <a href="http://en.wikipedia.org/wiki/Methodius_of_Olympus" title="Methodius of Olympus">Methodius</a>, <a href="http://en.wikipedia.org/wiki/Pistis_Sophia" title="Pistis Sophia">Pistis Sophia</a>, <a href="http://en.wikipedia.org/wiki/Porphyry_%28philosopher%29" title="Porphyry (philosopher)">Porphyry Tyrius</a>, <a href="http://en.wikipedia.org/wiki/Commodianus" title="Commodianus">Commodianus</a> (Ante-Nicene Fathers) </event>
<event namespace="Christianity" start="250" title="Papyrus 72"> Papyrus 72: Bodmer 5-11+, pub. 1959, "Alexandrian" text-type: Nativity of Mary; 3Cor; Odes of Solomon 11; Jude 1-25; Melito's Homily on Passover; Hymn fragment; Apology of Phileas; Ps33,34; 1Pt1:1-5:14; 2Pt1:1-3:18 </event>
<event namespace="Christianity" start="250" title="Origen"> <a href="http://en.wikipedia.org/wiki/Origen" title="Origen">Origen</a>, <a href="http://en.wikipedia.org/wiki/Ousios" title="Ousios">Jesus and God one substance</a>, adopted at <a href="http://en.wikipedia.org/wiki/First_Council_of_Nicaea" title="First Council of Nicaea">First Council of Nicaea</a> in 325, compiled <a href="http://en.wikipedia.org/wiki/Hexapla" title="Hexapla">Hexapla</a>; cites Alexandrian, <a href="http://en.wikipedia.org/wiki/Caesarean_text-type" title="Caesarean text-type">Caesarean text-type</a>; <a href="http://en.wikipedia.org/wiki/Eusebius" title="Eusebius">Eusebius</a> claimed Origen castrated himself for Christ due to Mt19:12 (EH6.8.1-3) </event>
<event namespace="Christianity" start="251" end="424" isDuration="true" title="Synods of Carthage"> <a href="http://en.wikipedia.org/wiki/Synods_of_Carthage" title="Synods of Carthage">Synods of Carthage</a> </event>
<event namespace="Christianity" start="251" end="258" isDuration="true" title="Antipope Novatian"> <a href="http://en.wikipedia.org/wiki/Antipope_Novatian" title="Antipope Novatian">Antipope Novatian</a>, decreed no forgiveness for sins after <a href="http://en.wikipedia.org/wiki/Baptism" title="Baptism">baptism</a> </event>
<event namespace="Christianity" start="254" end="257" isDuration="true" title="Schism over rebaptizing heretics and apostates"> <a href="http://en.wikipedia.org/wiki/Pope_Stephen_I" title="Pope Stephen I">Pope Stephen I</a>; major <a href="http://en.wikipedia.org/wiki/Schism" title="Schism">schism</a> over rebaptizing <a href="http://en.wikipedia.org/wiki/Heretics" title="Heretics">heretics</a> and <a href="http://en.wikipedia.org/wiki/Apostates" title="Apostates">apostates</a> </event>
<event namespace="Christianity" start="258" title="Roman emperor executes Christian Bishops, Elders, Deacons"> "<a href="http://en.wikipedia.org/wiki/Valerian_%28emperor%29" title="Valerian (emperor)">Valerian</a>'s Massacre", Roman emperor executes all Christian Bishops, Elders, and Deacons </event>
<event namespace="Christianity" start="264" end="269" isDuration="true" title="Founder of Adoptionism condemned"> <a href="http://en.wikipedia.org/wiki/Synods_of_Antioch" title="Synods of Antioch">Synods of Antioch</a>, condemned <a href="http://en.wikipedia.org/wiki/Paul_of_Samosata" title="Paul of Samosata">Paul of Samosata</a>, Bishop of Antioch, founder of <a href="http://en.wikipedia.org/wiki/Adoptionism" title="Adoptionism">Adoptionism</a> (Jesus was human until Holy Spirit descended at his baptism), also condemned term <a href="http://en.wikipedia.org/wiki/Ousios" title="Ousios">homoousios</a> adopted at Nicaea </event>
<event namespace="Christianity" start="265" title="Gregory Thaumaturgus"> <a href="http://en.wikipedia.org/wiki/Gregory_Thaumaturgus" title="Gregory Thaumaturgus">Gregory Thaumaturgus</a> (Ante-Nicene Fathers) </event>
<event namespace="Christianity" start="270" title="Anthony the Great begins monastic movement"> <a href="http://en.wikipedia.org/wiki/Anthony_the_Great" title="Anthony the Great">Anthony</a> begins monastic movement </event>
<event namespace="Christianity" start="275" title="Papyrus 47"> Papyrus 47: 3rd Chester Beatty, ~Sinaiticus, Rev9:10-11:3,5-16:15,17-17:2 </event>
<event namespace="Christianity" start="276" title="Mani prophet crucified"> <a href="http://en.wikipedia.org/wiki/Mani_%28prophet%29" title="Mani (prophet)">Mani (prophet)</a>, crucified, founder of <a href="http://en.wikipedia.org/wiki/Manichaean" title="Manichaean">Manichaean</a> Christian sect in <a href="http://en.wikipedia.org/wiki/Persia" title="Persia">Persia</a> </event>
<event namespace="Christianity" start="282" end="300" isDuration="true" title="Theonas of Alexandria"> <a href="http://en.wikipedia.org/wiki/Theonas_of_Alexandria" title="Theonas of Alexandria">Theonas</a>, bishop of Alexandria (Ante-Nicene Fathers) </event>
<event namespace="Christianity" start="290" end="345" isDuration="true" title="Founder of Christian monasticism"> <a href="http://en.wikipedia.org/wiki/St_Pachomius" title="St Pachomius">St Pachomius</a>, founder of <a href="http://en.wikipedia.org/wiki/Christian_monasticism" title="Christian monasticism">Christian monasticism</a> </event>
<event namespace="Christianity" start="296" end="304" isDuration="true" title="Pope Marcellinus offers pagan sacrifices"> <a href="http://en.wikipedia.org/wiki/Pope_Marcellinus" title="Pope Marcellinus">Pope Marcellinus</a>, offered pagan sacrifices for Diocletian </event>
<event namespace="Christianity" start="301" title="Christianity state religion of Armenia"> <a href="http://en.wikipedia.org/wiki/History_of_Armenia#Christianisation" title="History of Armenia">Armenia</a>, first to adopt Christianity as <a href="http://en.wikipedia.org/wiki/State_religion" title="State religion">state religion</a> </event>
<event namespace="Christianity" start="303" end="312" isDuration="true" title="Diocletian's Massacre of Christians"> <a href="http://en.wikipedia.org/wiki/Diocletian#Persecution_of_Christians" title="Diocletian">Diocletian's Massacre</a> of Christians </event>
<event namespace="Christianity" start="303" title="Saint George"> <a href="http://en.wikipedia.org/wiki/Saint_George" title="Saint George">Saint George</a>, patron saint of <a href="http://en.wikipedia.org/wiki/England" title="England">England</a>, and other states </event>
<event namespace="Christianity" start="304" title="Victorinus of Pettau"> 304? <a href="http://en.wikipedia.org/wiki/Victorinus_of_Pettau" title="Victorinus of Pettau">Victorinus</a>, bishop of <a href="http://en.wikipedia.org/wiki/Ptuj" title="Ptuj">Pettau</a> </event>
<event namespace="Christianity" start="306" title=""> 306 <a href="http://en.wikipedia.org/wiki/Synod_of_Elvira" title="Synod of Elvira">Synod of Elvira</a>, prohibited relations between Christians and Jews </event>
<event namespace="Christianity" start="310" title="Maxentius deports Pope Eusebius"> <a href="http://en.wikipedia.org/wiki/Maxentius" title="Maxentius">Maxentius</a> deports <a href="http://en.wikipedia.org/wiki/Pope_Eusebius" title="Pope Eusebius">Pope Eusebius</a> and Antipope Heraclius<a href="http://www.newadvent.org/cathen/09001b.htm" class="external autonumber" title="http://www.newadvent.org/cathen/09001b.htm">[6]</a> to Sicily </event>
<event namespace="Christianity" start="312" title="School of Antioch founded"> <a href="http://en.wikipedia.org/wiki/Lucian_of_Antioch" title="Lucian of Antioch">Lucian of Antioch</a>, founded <a href="http://en.wikipedia.org/wiki/School_of_Antioch" title="School of Antioch">School of Antioch</a>, martyred </event>
<event namespace="Christianity" start="312" title="Vision of Constantine"> <a href="http://en.wikipedia.org/wiki/Constantine_I_and_Christianity#Constantine.27s_Vision" title="Constantine I and Christianity">Vision of Constantine</a>, while gazing into the sun he saw a <a href="http://en.wikipedia.org/wiki/Cross" title="Cross">cross</a> with the words <a href="http://en.wikipedia.org/wiki/In_hoc_signo_vinces" title="In hoc signo vinces">by this sign conquer</a>, see also <a href="http://en.wikipedia.org/wiki/Labarum" title="Labarum">Labarum</a>, Constantine was later called the <i>13th Apostle</i> </event>
<event namespace="Christianity" start="313" title="Christianity state religion of Kingdom of Aksum"> The Kingdom of Aksum(Modern Ethiopia) declares Christianity as the official state Religion </event>
<event namespace="Christianity" start="313" title="Edict of Milan"> <a href="http://en.wikipedia.org/wiki/Edict_of_Milan" title="Edict of Milan">Edict of Milan</a>, Constantine and <a href="http://en.wikipedia.org/wiki/Licinius" title="Licinius">Licinius</a> end persecution, establish toleration of Christianity </event>
<event namespace="Christianity" start="313" title="Pope Miltiades excommunicates Donatus Magnus"> <a href="http://en.wikipedia.org/wiki/Pope_Miltiades" title="Pope Miltiades">Pope Miltiades</a>, given <a href="http://en.wikipedia.org/wiki/Lateran_Palace" title="Lateran Palace">Lateran Palace</a> as residence by Constantine, excommunicated <a href="http://en.wikipedia.org/wiki/Donatus_Magnus" title="Donatus Magnus">Donatus Magnus</a> for requiring rebaptism of apostates </event>
<event namespace="Christianity" start="314" title="Council of Arles against Donatist schism"> Council of Arles, called by Constantine against <a href="http://en.wikipedia.org/wiki/Donatist" title="Donatist">Donatist</a> schism </event>
<event namespace="Christianity" start="314" end="340" isDuration="true" title="Ecclesiastical History written"> <a href="http://en.wikipedia.org/wiki/Eusebius_of_Caesarea" title="Eusebius of Caesarea">Eusebius</a>, bishop of Caesarea, church historian, cited <a href="http://en.wikipedia.org/wiki/Caesarean_text-type" title="Caesarean text-type">Caesarean text-type</a>, wrote <i>Ecclesiastical History</i> in 325 </event>
<event namespace="Christianity" start="317" title="Christianity state religion of Iberia"> <a href="http://en.wikipedia.org/wiki/Mirian_III_of_Iberia" title="Mirian III of Iberia">Mirian III of Georgia</a> adopts Christianity as <a href="http://en.wikipedia.org/wiki/State_religion" title="State religion">state religion</a> </event>
<event namespace="Christianity" start="317" title="Lactantius"> <a href="http://en.wikipedia.org/wiki/Lactantius" title="Lactantius">Lactantius</a> </event>
<event namespace="Christianity" start="321" title="Sunday state day of rest"> Constantine decreed <a href="http://en.wikipedia.org/wiki/Sunday" title="Sunday">Sunday</a> as state "day of rest" (<a href="http://en.wikipedia.org/wiki/Corpus_Iuris_Civilis#Codex_Justinianus" title="Corpus Iuris Civilis">CJ</a>3.12.2), see also <a href="http://en.wikipedia.org/wiki/Sol_Invictus" title="Sol Invictus">Sol Invictus</a> </event>
<event namespace="Christianity" start="325" title="First Council of Nicaea to unify Christology"> <a href="http://en.wikipedia.org/wiki/First_Council_of_Nicaea" title="First Council of Nicaea">First Council of Nicaea</a>, called by Constantine to unify <a href="http://en.wikipedia.org/wiki/Christology" title="Christology">Christology</a>, called 1st great Christian council by <a href="http://en.wikipedia.org/wiki/Jerome" title="Jerome">Jerome</a>, 1st <a href="http://en.wikipedia.org/wiki/Ecumenical" title="Ecumenical">ecumenical</a>, <a href="http://en.wikipedia.org/wiki/Nicene_Creed#The_original_Nicene_Creed_of_325" title="Nicene Creed">Original Nicene Creed</a>, rejected by <a href="http://en.wikipedia.org/wiki/Nontrinitarianism" title="Nontrinitarianism">Nontrinitarianism</a>, <a href="http://en.wikipedia.org/wiki/Arius" title="Arius">Arius</a>, Theonas, Secundus, <a href="http://en.wikipedia.org/wiki/Eusebius_of_Nicomedia" title="Eusebius of Nicomedia">Eusebius of Nicomedia</a>, Theognis <a href="http://en.wikipedia.org/wiki/Excommunicated" title="Excommunicated">excommunicated</a>, addressed <a href="http://en.wikipedia.org/wiki/Computus" title="Computus">Easter controversies</a>, passed 20 <a href="http://en.wikipedia.org/wiki/Canon_law_%28Catholic_Church%29" title="Canon law (Catholic Church)">Canon laws</a> </event>
<event namespace="Christianity" start="325" title="Church of the Nativity"> <a href="http://en.wikipedia.org/wiki/Church_of_the_Nativity" title="Church of the Nativity">Church of the Nativity</a> in <a href="http://en.wikipedia.org/wiki/Bethlehem" title="Bethlehem">Bethlehem</a> </event>
<event namespace="Christianity" start="328" end="373" isDuration="true" title="New Testament first cited"> <a href="http://en.wikipedia.org/wiki/Athanasius" title="Athanasius">Athanasius</a>, bishop of Alexandria, first cite of modern 27 book <a href="http://en.wikipedia.org/wiki/New_Testament" title="New Testament">New Testament</a> <a href="http://en.wikipedia.org/wiki/Biblical_canon" title="Biblical canon">canon</a> </event>
<event namespace="Christianity" start="330" title="Church of the Holy Apostles"> Old <a href="http://en.wikipedia.org/wiki/Church_of_the_Holy_Apostles" title="Church of the Holy Apostles">Church of the Holy Apostles</a>, dedicated by Constantine </event>
<event namespace="Christianity" start="330" title="Saint Peter's Basilica"> Old <a href="http://en.wikipedia.org/wiki/Saint_Peter%27s_Basilica" title="Saint Peter's Basilica">Saint Peter's Basilica</a> dedicated by Constantine, located over the traditional burial site of Saint Peter the Apostle in Rome on Vatican Hill </event>
<event namespace="Christianity" start="331" title="Constantinople capital of Roman Empire"> Capital of <a href="http://en.wikipedia.org/wiki/Eastern_Roman_Empire" title="Eastern Roman Empire">Roman Empire</a> moved from Rome to <a href="http://en.wikipedia.org/wiki/Constantinople" title="Constantinople">Constantinople</a> (<a href="http://en.wikipedia.org/wiki/New_Rome" title="New Rome">New Rome</a>) </event>
<event namespace="Christianity" start="335" title="Jerusalem consecrated"> Council in Jerusalem, reversed Nicaea's condemnation of <a href="http://en.wikipedia.org/wiki/Arius" title="Arius">Arius</a>, consecrated Jerusalem <a href="http://en.wikipedia.org/wiki/Church_of_the_Holy_Sepulchre" title="Church of the Holy Sepulchre">Church of the Holy Sepulchre</a> </event>
<event namespace="Christianity" start="343" title="Council of Sardica"> <a href="http://en.wikipedia.org/wiki/Council_of_Sardica" title="Council of Sardica">Council of Sardica</a> </event>
<event namespace="Christianity" start="350" title="Julius Firmicus Maternus"> <a href="http://en.wikipedia.org/wiki/Julius_Firmicus_Maternus" title="Julius Firmicus Maternus">Julius Firmicus Maternus</a> </event>
<event namespace="Christianity" start="350" title="Codex Sinaiticus"> <a href="http://en.wikipedia.org/wiki/Codex_Sinaiticus" title="Codex Sinaiticus">Codex Sinaiticus</a>(S), <a href="http://en.wikipedia.org/wiki/Codex_Vaticanus" title="Codex Vaticanus">Codex Vaticanus</a>(B): earliest Christian Bibles, <a href="http://en.wikipedia.org/wiki/Alexandrian_text-type" title="Alexandrian text-type">Alexandrian text-type</a> </event>
<event namespace="Christianity" start="350" title="Greek NT translated to Gothic"> 350? <a href="http://en.wikipedia.org/wiki/Ulfilas" title="Ulfilas">Ulfilas</a>, Arian, apostle to the <a href="http://en.wikipedia.org/wiki/Goths" title="Goths">Goths</a>, translated Greek NT to Gothic </event>
<event namespace="Christianity" start="350" title="Comma Johanneum"> <a href="http://en.wikipedia.org/wiki/Comma_Johanneum" title="Comma Johanneum">Comma Johanneum</a> 1Jn5:7b-8a(<a href="http://en.wikipedia.org/wiki/KJV" title="KJV">KJV</a>) </event>
<event namespace="Christianity" start="350" title="Syntagmation"> <a href="http://en.wikipedia.org/wiki/A%C3%ABtius_%28theologian%29" title="Aëtius (theologian)">Aëtius</a>, Arian, "Syntagmation": "God is agennetos (unbegotten)", (<a href="http://en.wikipedia.org/wiki/Anomoean" title="Anomoean">Anomoean</a>) </event>
<event namespace="Christianity" start="350" title="School of Nisibis"> <a href="http://en.wikipedia.org/wiki/School_of_Nisibis" title="School of Nisibis">School of Nisibis</a> founded </event>
<event namespace="Christianity" start="351" title="2nd Council of Sirmium condemned Council of Nicaea"> 2nd <a href="http://en.wikipedia.org/wiki/Council_of_Sirmium" title="Council of Sirmium">Council of Sirmium</a>, Anomoean, condemned Council of Nicaea </event>
<event namespace="Christianity" start="353" end="367" isDuration="true" title="Hilary of Poitiers"> <a href="http://en.wikipedia.org/wiki/Hilary_of_Poitiers" title="Hilary of Poitiers">Hilary</a>, bishop of <a href="http://en.wikipedia.org/wiki/Poitiers" title="Poitiers">Poitiers</a> </event>
<event namespace="Christianity" start="355" end="365" isDuration="true" title="Antipope Felix II"> <a href="http://en.wikipedia.org/wiki/Antipope_Felix_II" title="Antipope Felix II">Antipope Felix II</a>, Arian, supported by <a href="http://en.wikipedia.org/wiki/Constantius_II" title="Constantius II">Constantius II</a> </event>
<event namespace="Christianity" start="359" title="Council of Rimini"> <a href="http://en.wikipedia.org/wiki/Council_of_Rimini" title="Council of Rimini">Council of Rimini</a>, Dated Creed (<a href="http://en.wikipedia.org/wiki/Acacians" title="Acacians">Acacians</a>) </event>
<event namespace="Christianity" start="363" end="364" isDuration="true" title="Council of Laodicea"> <a href="http://en.wikipedia.org/wiki/Council_of_Laodicea" title="Council of Laodicea">Council of Laodicea</a>, canon 29 decreed <a href="http://en.wikipedia.org/wiki/Anathema" title="Anathema">anathema</a> for Christians who rest on the <a href="http://en.wikipedia.org/wiki/Sabbath" title="Sabbath">Sabbath</a>, disputed canon 60 named 26 NT books (excluded <a href="http://en.wikipedia.org/wiki/Revelation" title="Revelation">Revelation</a>) </event>
<event namespace="Christianity" start="366" end="367" isDuration="true" title="Antipope Ursicinus"> <a href="http://en.wikipedia.org/wiki/Antipope_Ursicinus" title="Antipope Ursicinus">Antipope Ursicinus</a>, rival to <a href="http://en.wikipedia.org/wiki/Pope_Damasus_I" title="Pope Damasus I">Pope Damasus I</a> </event>
<event namespace="Christianity" start="367" end="403" isDuration="true" title="Panarion against heresies"> <a href="http://en.wikipedia.org/wiki/Epiphanius_of_Salamis" title="Epiphanius of Salamis">Epiphanius</a>, bishop of Salamis, wrote <i>Panarion</i> against heresies </event>
<event namespace="Christianity" start="370" end="379" isDuration="true" title="Basil of Caesarea"> <a href="http://en.wikipedia.org/wiki/Basil_of_Caesarea" title="Basil of Caesarea">Basil the Great</a>, Bishop of Caesarea </event>
<event namespace="Christianity" start="370" title="Doctrine of Addai"> <a href="http://en.wikipedia.org/wiki/Doctrine_of_Addai" title="Doctrine of Addai">Doctrine of Addai</a> at Edessa proclaims 17 book NT canon using Diatessaron (instead of the 4 Gospels) + Acts + 15 Pauline Epistles (inc. <a href="http://en.wikipedia.org/wiki/3_Corinthians" title="3 Corinthians">3 Corinthians</a>) <a href="http://en.wikipedia.org/wiki/Syriac_Orthodox_Church" title="Syriac Orthodox Church">Syriac Orthodox Church</a> </event>
<event namespace="Christianity" start="372" end="394" isDuration="true" title="Gregory of Nyssa"> <a href="http://en.wikipedia.org/wiki/Gregory_of_Nyssa" title="Gregory of Nyssa">Gregory</a>, Bishop Of Nyssa </event>
<event namespace="Christianity" start="373" title="Ephrem the Syrian"> <a href="http://en.wikipedia.org/wiki/Ephrem_the_Syrian" title="Ephrem the Syrian">Ephrem the Syrian</a>, cited "Western" Acts text-type </event>
<event namespace="Christianity" start="374" end="397" isDuration="true" title="Ambrose, bishop, governor of Milan"> <a href="http://en.wikipedia.org/wiki/Ambrose" title="Ambrose">Ambrose</a>, bishop & governor of <a href="http://en.wikipedia.org/wiki/Milan" title="Milan">Milan</a> </event>
<event namespace="Christianity" start="375" end="395" isDuration="true" title="Ausonius, governor of Gaul"> <a href="http://en.wikipedia.org/wiki/Ausonius" title="Ausonius">Ausonius</a>, Christian governor of <a href="http://en.wikipedia.org/wiki/Gaul" title="Gaul">Gaul</a> </event>
<event namespace="Christianity" start="379" end="381" isDuration="true" title="Gregory Nazianzus, bishop of Constantinople"> <a href="http://en.wikipedia.org/wiki/Gregory_Nazianzus" title="Gregory Nazianzus">Gregory Nazianzus</a>, <a href="http://en.wikipedia.org/wiki/Bishop_of_Constantinople" title="Bishop of Constantinople">Bishop of Constantinople</a> </event>
<event namespace="Christianity" start="381" title="2nd Ecumenical"> <a href="http://en.wikipedia.org/wiki/First_Council_of_Constantinople" title="First Council of Constantinople">First Council of Constantinople</a>, 2nd <a href="http://en.wikipedia.org/wiki/Ecumenical" title="Ecumenical">ecumenical</a>, Jesus had true human soul, <a href="http://en.wikipedia.org/wiki/Nicene_Creed#The_Nicene_Creed_of_381" title="Nicene Creed">Nicene Creed of 381</a> </event>
<event namespace="Christianity" start="382" title="Council of Rome disputed"> <a href="http://en.wikipedia.org/wiki/Council_of_Rome" title="Council of Rome">Council of Rome</a>, held by <a href="http://en.wikipedia.org/wiki/Pope_Damasus_I" title="Pope Damasus I">Pope Damasus I</a>, disputed </event>
<event namespace="Christianity" start="383" title="Frumentius, Apostle of Ethiopia"> <a href="http://en.wikipedia.org/wiki/Frumentius" title="Frumentius">Frumentius</a>, Apostle of Ethiopia </event>
<event namespace="Christianity" start="385" title="First heretic executed"> <a href="http://en.wikipedia.org/wiki/Priscillian" title="Priscillian">Priscillian</a>, first heretic to be executed? </event>
<event namespace="Christianity" start="390" title="Nicene Christianity declared state religion by Theodosius the Great"> Feb 27, <a href="http://en.wikipedia.org/wiki/Nicene_Christianity" title="Nicene Christianity">Nicene Christianity</a> declared <a href="http://en.wikipedia.org/wiki/State_religion" title="State religion">state religion</a> by <a href="http://en.wikipedia.org/wiki/Theodosius_the_Great" title="Theodosius the Great">Theodosius the Great</a> </event>
<event namespace="Christianity" start="390" title="Apollinaris of Laodicea"> <a href="http://en.wikipedia.org/wiki/Apollinaris_of_Laodicea" title="Apollinaris of Laodicea">Apollinaris</a>, bishop of Laodicea, believed Jesus had human body but divine spirit </event>
<event namespace="Christianity" start="396" end="430" isDuration="true" title="Augustine of Hippo"> <a href="http://en.wikipedia.org/wiki/Augustine_of_Hippo" title="Augustine of Hippo">Augustine</a>, bishop of Hippo, considered the founder of formalized Christian theology (<a href="http://en.wikipedia.org/wiki/Nicene_and_Post-Nicene_Fathers" title="Nicene and Post-Nicene Fathers">Nicene and Post-Nicene Fathers</a>) </event>
<event namespace="Christianity" start="397" title="Saint Ninian"> <a href="http://en.wikipedia.org/wiki/Saint_Ninian" title="Saint Ninian">Saint Ninian</a> evangelizes <a href="http://en.wikipedia.org/wiki/Picts" title="Picts">Picts</a> in <a href="http://en.wikipedia.org/wiki/Scotland" title="Scotland">Scotland</a> </event>
<event namespace="Christianity" start="398" end="404" isDuration="true" title="John Chrysostom"> 398-404 <a href="http://en.wikipedia.org/wiki/John_Chrysostom" title="John Chrysostom">John Chrysostom</a> <a href="http://en.wikipedia.org/wiki/Patriarch_of_Constantinople" title="Patriarch of Constantinople">Patriarch of Constantinople</a>, see also <a href="http://en.wikipedia.org/wiki/List_of_Patriarchs_of_Constantinople" title="List of Patriarchs of Constantinople">List of Patriarchs of Constantinople</a>, (Nicene and Post-Nicene Fathers) </event>
<event namespace="Christianity" start="400" title="Ethiopic Bible"> Ethiopic Bible: in Ge'ez, 81 books, standard <a href="http://en.wikipedia.org/wiki/Ethiopian_Orthodox" title="Ethiopian Orthodox">Ethiopian Orthodox</a> Bible </event>
<event namespace="Christianity" start="400" title="Bible in Syriac"> <a href="http://en.wikipedia.org/wiki/Peshitta" title="Peshitta">Peshitta</a> Bible in Syriac (Aramaic), Syr(p), OT + 22 NT, excludes: 2Pt, 2-3Jn, Jude, Rev; standard <a href="http://en.wikipedia.org/wiki/Syriac_Orthodox_Church" title="Syriac Orthodox Church">Syriac Orthodox Church</a> Bible </event>
<event namespace="Christianity" start="406" title="Armenian bible"> Armenian Bible, translated by <a href="http://en.wikipedia.org/wiki/Saint_Mesrob" title="Saint Mesrob">Saint Mesrob</a>, standard <a href="http://en.wikipedia.org/wiki/Armenian_Orthodox" title="Armenian Orthodox">Armenian Orthodox</a> Bible </event>
<event namespace="Christianity" start="412" end="444" isDuration="true" title="Cyril of Alexandria expels Jews"> <a href="http://en.wikipedia.org/wiki/Cyril_of_Alexandria" title="Cyril of Alexandria">Cyril</a>, bishop of Alexandria, expelled Jews, killed <a href="http://en.wikipedia.org/wiki/Hypatia" title="Hypatia">Hypatia</a> with oyster shells, coined <a href="http://en.wikipedia.org/wiki/Hypostatic_union" title="Hypostatic union">Hypostatic union</a> </event>
<event namespace="Christianity" start="418" end="419" isDuration="true" title="Antipope Eulalius"> <a href="http://en.wikipedia.org/wiki/Antipope_Eulalius" title="Antipope Eulalius">Antipope Eulalius</a> rival to <a href="http://en.wikipedia.org/wiki/Pope_Boniface_I" title="Pope Boniface I">Pope Boniface I</a> </event>
<event namespace="Christianity" start="420" title="St. Jerome"> St. <a href="http://en.wikipedia.org/wiki/Jerome" title="Jerome">Jerome</a>, <a href="http://en.wikipedia.org/wiki/Vulgate#Different_versions" title="Vulgate">Vulgate</a> translations, <a href="http://en.wikipedia.org/wiki/Latin" title="Latin">Latin</a> scholar, cited <a href="http://en.wikipedia.org/wiki/Mark_16#The_.27Freer_Logion.27_and_.27Expanded.27_Endings" title="Mark 16">expanded ending in Mark</a> after Mark 16:8, <a href="http://en.wikipedia.org/wiki/Pericope_Adulter%C3%A6" title="Pericope Adulteræ">Pericope of the Adultress</a> addition to John (John 7:53-8:11) (Nicene and Post-Nicene Fathers) </event>
<event namespace="Christianity" start="423" end="457" isDuration="true" title="Theodoret"> <a href="http://en.wikipedia.org/wiki/Theodoret" title="Theodoret">Theodoret</a>, bishop of <a href="http://en.wikipedia.org/wiki/Cyrrhus" title="Cyrrhus">Cyrrhus</a>, noted Tatian's <a href="http://en.wikipedia.org/wiki/Diatesseron" title="Diatesseron">Diatesseron</a> in heavy use </event>
<event namespace="Christianity" start="431" title="Council of Ephesus"> <a href="http://en.wikipedia.org/wiki/Council_of_Ephesus" title="Council of Ephesus">Council of Ephesus</a>, 3rd <a href="http://en.wikipedia.org/wiki/Ecumenical" title="Ecumenical">ecumenical</a>, repudiated <a href="http://en.wikipedia.org/wiki/Nestorianism" title="Nestorianism">Nestorianism</a>, decreed <a href="http://en.wikipedia.org/wiki/Theotokos" title="Theotokos">Mary the Mother of God</a>, forbid any changes to <a href="http://en.wikipedia.org/wiki/Nicene_Creed#The_Nicene_Creed_of_381" title="Nicene Creed">Nicene Creed of 381</a>, rejected by <a href="http://en.wikipedia.org/wiki/Assyrian_Church_of_the_East" title="Assyrian Church of the East">Assyrian Church of the East</a> </event>
<event namespace="Christianity" start="432" title="St. Patrick begins mission in Ireland"> <a href="http://en.wikipedia.org/wiki/St_Patrick" title="St Patrick">St Patrick</a> begins mission in <a href="http://en.wikipedia.org/wiki/Ireland" title="Ireland">Ireland</a> </event>
<event namespace="Christianity" start="440" end="461" isDuration="true" title="Pope Leo I first pope, stopped Attila the Hun"> <a href="http://en.wikipedia.org/wiki/Pope_Leo_I" title="Pope Leo I">Pope Leo the Great</a>, sometimes considered the first pope, stopped <a href="http://en.wikipedia.org/wiki/Attila_the_Hun" title="Attila the Hun">Attila the Hun</a> at Rome, issued <a href="http://en.wikipedia.org/wiki/Pope_Leo_I#The_Tome" title="Pope Leo I">Tome</a> in support of <a href="http://en.wikipedia.org/wiki/Hypostatic_Union" title="Hypostatic Union">Hypostatic Union</a>, approved <a href="http://en.wikipedia.org/wiki/Council_of_Chalcedon" title="Council of Chalcedon">Council of Chalcedon</a> but rejected canons in 453 </event>
<event namespace="Christianity" start="447" title="Councils of Toledo"> <a href="http://en.wikipedia.org/wiki/Councils_of_Toledo" title="Councils of Toledo">Council of Toledo</a> added <a href="http://en.wikipedia.org/wiki/Filioque_clause" title="Filioque clause">Filioque clause</a> to <a href="http://en.wikipedia.org/wiki/Nicene_Creed#The_Nicene_Creed_of_381" title="Nicene Creed">Nicene Creed of 381</a> </event>
<event namespace="Christianity" start="449" title="Robber Council of Ephesus"> <a href="http://en.wikipedia.org/wiki/Robber_Council_of_Ephesus" title="Robber Council of Ephesus">Robber Council of Ephesus</a>, <a href="http://en.wikipedia.org/wiki/Monophysite" title="Monophysite">Monophysite</a>: Jesus was divine but not human </event>
<event namespace="Christianity" start="450" title="Codex Alexandrinus"> <a href="http://en.wikipedia.org/wiki/Codex_Alexandrinus" title="Codex Alexandrinus">Codex Alexandrinus</a>(A): <a href="http://en.wikipedia.org/wiki/Alexandrian_text-type" title="Alexandrian text-type">Alexandrian text-type</a>; <a href="http://en.wikipedia.org/wiki/Codex_Bezae" title="Codex Bezae">Codex Bezae</a>(D): Greek/Latin Gospels + Acts; <a href="http://en.wikipedia.org/wiki/Codex_Washingtonianus" title="Codex Washingtonianus">Codex Washingtonianus</a>(W): Greek Gospels; both of <a href="http://en.wikipedia.org/wiki/Western_text-type" title="Western text-type">Western text-type</a> </event>
<event namespace="Christianity" start="450" title="Old Testament in Aramaic"> Aramaic <a href="http://en.wikipedia.org/wiki/Targums" title="Targums">Targums</a>, <a href="http://en.wikipedia.org/wiki/Old_Testament" title="Old Testament">Old Testament</a> in <a href="http://en.wikipedia.org/wiki/Aramaic" title="Aramaic">Aramaic</a> </event>
<event namespace="Christianity" start="450" title="Socrates Scholasticus"> <a href="http://en.wikipedia.org/wiki/Socrates_Scholasticus" title="Socrates Scholasticus">Socrates Scholasticus</a>, <a href="http://en.wikipedia.org/wiki/Sozomen" title="Sozomen">Sozomen</a>, early Church historians </event>
<event namespace="Christianity" start="451" title="Council of Chalcedon"> <a href="http://en.wikipedia.org/wiki/Council_of_Chalcedon" title="Council of Chalcedon">Council of Chalcedon</a>, 4th <a href="http://en.wikipedia.org/wiki/Ecumenical" title="Ecumenical">ecumenical</a>, declared Jesus is a <a href="http://en.wikipedia.org/wiki/Hypostatic_Union" title="Hypostatic Union">Hypostatic Union</a>: both human and divine in one, <a href="http://en.wikipedia.org/wiki/Chalcedonian_Creed" title="Chalcedonian Creed">Chalcedonian Creed</a>, rejected by <a href="http://en.wikipedia.org/wiki/Oriental_Orthodoxy" title="Oriental Orthodoxy">Oriental Orthodoxy</a> </event>
<event namespace="Christianity" start="456" title="Eutyches of Constantinople"> <a href="http://en.wikipedia.org/wiki/Eutyches" title="Eutyches">Eutyches</a> of Constantinople, <a href="http://en.wikipedia.org/wiki/Monophysite" title="Monophysite">Monophysite</a> </event>
<event namespace="Christianity" start="465" title="Prosper of Aquitaine"> <a href="http://en.wikipedia.org/wiki/Prosper_of_Aquitaine" title="Prosper of Aquitaine">Prosper of Aquitaine</a> </event>
<event namespace="Christianity" start="476" title="Fall of Rome"> September 4th, <a href="http://en.wikipedia.org/wiki/Fall_of_Rome" title="Fall of Rome">Fall of Rome</a> </event>
<event namespace="Christianity" start="484" end="519" isDuration="true" title="Acacian Schism"> <a href="http://en.wikipedia.org/wiki/Acacian_Schism" title="Acacian Schism">Acacian Schism</a>, over <a href="http://en.wikipedia.org/wiki/Henoticon" title="Henoticon">Henoticon</a> divides Eastern (Greek) and Western (Latin) churches </event>
<event namespace="Christianity" start="491" title="Armenian Orthodox"> <a href="http://en.wikipedia.org/wiki/Armenian_Orthodox" title="Armenian Orthodox">Armenian Orthodox</a> split from East (Greek) and West (Latin) churches </event>
<event namespace="Christianity" start="495" title="Vicar of Christ"> May 13 <a href="http://en.wikipedia.org/wiki/Vicar_of_Christ" title="Vicar of Christ">Vicar of Christ</a> decreed a title of Bishop of Rome by <a href="http://en.wikipedia.org/wiki/Pope_Gelasius_I" title="Pope Gelasius I">Pope Gelasius I</a> </event>
<event namespace="Christianity" start="496" title="Clovis I baptized"> <a href="http://en.wikipedia.org/wiki/Clovis_I" title="Clovis I">Clovis I</a>, King of the <a href="http://en.wikipedia.org/wiki/Franks" title="Franks">Franks</a>, baptized </event>
<event namespace="Christianity" start="498" end="499" isDuration="true" title="Antipope Laurentius"> <a href="http://en.wikipedia.org/wiki/Antipope_Laurentius" title="Antipope Laurentius">Antipope Laurentius</a>, rival of <a href="http://en.wikipedia.org/wiki/Pope_Symmachus" title="Pope Symmachus">Pope Symmachus</a> </event>
<event namespace="Christianity" start="501" end="506" isDuration="true" title="Antipope Laurentius"> <a href="http://en.wikipedia.org/wiki/Antipope_Laurentius" title="Antipope Laurentius">Antipope Laurentius</a>, rival of <a href="http://en.wikipedia.org/wiki/Pope_Symmachus" title="Pope Symmachus">Pope Symmachus</a> </event>
<event namespace="Christianity" start="500" title="Incense in Christian churce service"> <a href="http://en.wikipedia.org/wiki/Incense" title="Incense">Incense</a> introduced in Christian church service, first plans of <a href="http://en.wikipedia.org/wiki/Vatican_City" title="Vatican City">Vatican</a> </event>
<event namespace="Christianity" start="524" title="Consolation of Philosophy"> <a href="http://en.wikipedia.org/wiki/Anicius_Manlius_Severinus_Boethius" title="Anicius Manlius Severinus Boethius">Boethius</a>, Roman Christian philosopher, wrote: "Theological Tractates", <a href="http://en.wikipedia.org/wiki/Consolation_of_Philosophy" title="Consolation of Philosophy">Consolation of Philosophy</a>; (Loeb Classics) (Latin) </event>
<event namespace="Christianity" start="525" title="Christian calendar set"> <a href="http://en.wikipedia.org/wiki/Dionysius_Exiguus" title="Dionysius Exiguus">Dionysius Exiguus</a> sets Christian calendar (a.d.) & Jesus' birth @ 23 Dec 1AD </event>
<event namespace="Christianity" start="527" title="Fabius Planciades Fulgentius"> <a href="http://en.wikipedia.org/wiki/Fabius_Planciades_Fulgentius" title="Fabius Planciades Fulgentius">Fabius Planciades Fulgentius</a> </event>
<event namespace="Christianity" start="530" title="Antipope Dioscorus"> <a href="http://en.wikipedia.org/wiki/Antipope_Dioscorus" title="Antipope Dioscorus">Antipope Dioscorus</a>, possibly a legitimate Pope </event>
<event namespace="Christianity" start="530" title="Rule of St. Benedict"> <a href="http://en.wikipedia.org/wiki/Rule_of_St_Benedict" title="Rule of St Benedict">Rule of St Benedict</a>, <a href="http://en.wikipedia.org/wiki/St._Benedict" title="St. Benedict">St. Benedict</a> founds the <a href="http://en.wikipedia.org/wiki/Benedictines" title="Benedictines">Benedictines</a> </event>
<event namespace="Christianity" start="535" end="536" isDuration="true" title="Unusual climate changes"> Unusual <a href="http://en.wikipedia.org/wiki/Climate_changes_of_535-536" title="Climate changes of 535-536">climate changes</a> recorded </event>
<event namespace="Christianity" start="537" end="555" isDuration="true" title="Popal conspiracy"> 537-555 <a href="http://en.wikipedia.org/wiki/Pope_Vigilius" title="Pope Vigilius">Pope Vigilius</a>, involved in death of <a href="http://en.wikipedia.org/wiki/Pope_Silverius" title="Pope Silverius">Pope Silverius</a>, conspired with <a href="http://en.wikipedia.org/wiki/Justinian_I" title="Justinian I">Justinian</a> and <a href="http://en.wikipedia.org/wiki/Theodora_%286th_century%29" title="Theodora (6th century)">Theodora</a>, on April 11, 548 issued <i>Judicatum</i> supporting Justinian's anti-<a href="http://en.wikipedia.org/wiki/Hypostatic_Union" title="Hypostatic Union">Hypostatic Union</a>, excommunicated by bishops of Carthage in 550 </event>
<event namespace="Christianity" start="541" end="542" isDuration="true" title="Plague of Justinian"> <a href="http://en.wikipedia.org/wiki/Plague_of_Justinian" title="Plague of Justinian">Plague of Justinian</a> </event>
<event namespace="Christianity" start="543" title="Justinian condemns Origen"> Justinian condemns <a href="http://en.wikipedia.org/wiki/Origen" title="Origen">Origen</a>, disastrous earthquakes hit the world </event>
<event namespace="Christianity" start="544" title="???"> Justinian <a href="http://en.wikipedia.org/wiki/Three-Chapter_Controversy" title="Three-Chapter Controversy">condemns the Three Chapters</a> of <a href="http://en.wikipedia.org/wiki/Theodore_of_Mopsuestia" title="Theodore of Mopsuestia">Theodore of Mopsuestia</a> (d.428) and other writings of <a href="http://en.wikipedia.org/wiki/Hypostatic_Union" title="Hypostatic Union">Hypostatic Union</a> <a href="http://en.wikipedia.org/wiki/Christology" title="Christology">Christology</a> of <a href="http://en.wikipedia.org/wiki/Council_of_Chalcedon" title="Council of Chalcedon">Council of Chalcedon</a> </event>
<event namespace="Christianity" start="550" title="St. David converts Wales"> <a href="http://en.wikipedia.org/wiki/St._David" title="St. David">St. David</a> converts <a href="http://en.wikipedia.org/wiki/Wales" title="Wales">Wales</a>. </event>
<event namespace="Christianity" start="550" title="Crucifix introduced"> <a href="http://en.wikipedia.org/wiki/Crucifix" title="Crucifix">crucifix</a> introduced </event>
<event namespace="Christianity" start="553" title="Second Council of Constantinople"> <a href="http://en.wikipedia.org/wiki/Second_Council_of_Constantinople" title="Second Council of Constantinople">Second Council of Constantinople</a>, 5th <a href="http://en.wikipedia.org/wiki/Ecumenical" title="Ecumenical">ecumenical</a>, called by Justinian </event>
<event namespace="Christianity" start="556" end="561" isDuration="true" title="Pope Pelagius I"> <a href="http://en.wikipedia.org/wiki/Pope_Pelagius_I" title="Pope Pelagius I">Pope Pelagius I</a>, selected by Justinian, endorsed <i>Judicatum</i> </event>
<event namespace="Christianity" start="563" title="Columba evangelizes in Scotland"> <a href="http://en.wikipedia.org/wiki/Columba" title="Columba">Columba</a> goes to <a href="http://en.wikipedia.org/wiki/Scotland" title="Scotland">Scotland</a> to evangelize <a href="http://en.wikipedia.org/wiki/Picts" title="Picts">Picts</a>, establishes <a href="http://en.wikipedia.org/wiki/Monastery" title="Monastery">monastery</a> at <a href="http://en.wikipedia.org/wiki/Iona" title="Iona">Iona</a> </event>
<event namespace="Christianity" start="567" title="Cassiodorus"> <a href="http://en.wikipedia.org/wiki/Cassiodorus" title="Cassiodorus">Cassiodorus</a> </event>
<event namespace="Christianity" start="589" title="Third Council of Toledo"> <a href="http://en.wikipedia.org/wiki/Third_Council_of_Toledo" title="Third Council of Toledo">Third Council of Toledo</a>, <a href="http://en.wikipedia.org/wiki/Reccared" title="Reccared">Reccared</a> and the <a href="http://en.wikipedia.org/wiki/Visigoths" title="Visigoths">Visigoths</a> convert from <a href="http://en.wikipedia.org/wiki/Arianism" title="Arianism">Arianism</a> to Catholicism </event>
<event namespace="Christianity" start="590" end="604" isDuration="true" title="Pope Gregory I reforms church"> <a href="http://en.wikipedia.org/wiki/Pope_Gregory_I" title="Pope Gregory I">Pope Gregory the Great</a>, whom many consider the greatest pope ever, reforms church structure and administration and establishes <a href="http://en.wikipedia.org/wiki/Gregorian_Chant" title="Gregorian Chant">Gregorian Chant</a>, <a href="http://en.wikipedia.org/wiki/Seven_deadly_sins" title="Seven deadly sins">Seven deadly sins</a> ... </event>
<event namespace="Christianity" start="591" end="628" isDuration="true" title="Theodelinda converts to Catholicism"> <a href="http://en.wikipedia.org/wiki/Theodelinda" title="Theodelinda">Theodelinda</a>, Queen of the <a href="http://en.wikipedia.org/wiki/Lombards" title="Lombards">Lombards</a>, began gradual conversion from Arianism to Catholicism </event>
<event namespace="Christianity" start="596" title="St. Augustine of Canterbury evangelises the Jutes"> <a href="http://en.wikipedia.org/wiki/St._Augustine_of_Canterbury" title="St. Augustine of Canterbury">St. Augustine of Canterbury</a> sent by Pope Gregory to evangelise the <a href="http://en.wikipedia.org/wiki/Jutes" title="Jutes">Jutes</a> </event>
<event namespace="Christianity" start="600" title="Evagrius Scholasticus, church historian"> <a href="http://en.wikipedia.org/wiki/Evagrius_Scholasticus" title="Evagrius Scholasticus">Evagrius Scholasticus</a> Church historian </event>
<event namespace="Christianity" start="604" title="St. Paul Cathedral"> <a href="http://en.wikipedia.org/wiki/St_Paul%27s_Cathedral" title="St Paul's Cathedral">St Paul's Cathedral</a> in <a href="http://en.wikipedia.org/wiki/London" title="London">London</a> </event>
<event namespace="Christianity" start="607" title="First Bishop of Rome called 'Pope'"> 607 <a href="http://en.wikipedia.org/wiki/Pope_Boniface_III" title="Pope Boniface III">Pope Boniface III</a>, first Bishop of Rome to be called "Pope" and "Universal Bishop" by decree of Emperor <a href="http://en.wikipedia.org/wiki/Phocas" title="Phocas">Phocas</a> </event>
<event namespace="Christianity" start="609" title="Pantheon"> <a href="http://en.wikipedia.org/wiki/Pantheon%2C_Rome" title="Pantheon, Rome">Pantheon, Rome</a> renamed Church of Santa Maria Rotonda </event>
<event namespace="Christianity" start="612" title="Bobbio monastery in northern Italy"> <a href="http://en.wikipedia.org/wiki/Bobbio" title="Bobbio">Bobbio</a> monastery in northern <a href="http://en.wikipedia.org/wiki/Italy" title="Italy">Italy</a> </event>
<event namespace="Christianity" start="613" title="Abbey of St. Gall in Switzerland"> <a href="http://en.wikipedia.org/wiki/Abbey_of_St._Gall" title="Abbey of St. Gall">Abbey of St. Gall</a> in <a href="http://en.wikipedia.org/wiki/Switzerland" title="Switzerland">Switzerland</a> </event>
<event namespace="Christianity" start="614" title="Khosrau II of Persia took Holy Cross of Christ"> <a href="http://en.wikipedia.org/wiki/Khosrau_II_of_Persia" title="Khosrau II of Persia">Khosrau II of Persia</a> conquered <a href="http://en.wikipedia.org/wiki/Damascus" title="Damascus">Damascus</a>, <a href="http://en.wikipedia.org/wiki/Jerusalem" title="Jerusalem">Jerusalem</a>, took <a href="http://en.wikipedia.org/wiki/True_Cross#Finding_the_True_Cross" title="True Cross">Holy Cross of Christ</a> </event>
<event namespace="Christianity" start="624" title="Beginning of Islamic Empire"> <a href="http://en.wikipedia.org/wiki/Battle_of_Badr" title="Battle of Badr">Battle of Badr</a>, considered beginning of <a href="http://en.wikipedia.org/wiki/Islamic_Empire" title="Islamic Empire">Islamic Empire</a> </event>
<event namespace="Christianity" start="625" title="Paulinus of York converts Northumbria"> <a href="http://en.wikipedia.org/wiki/Paulinus_of_York" title="Paulinus of York">Paulinus of York</a> comes to convert <a href="http://en.wikipedia.org/wiki/Northumbria" title="Northumbria">Northumbria</a> </event>
<event namespace="Christianity" start="628" title="Babai the Great dies"> <a href="http://en.wikipedia.org/wiki/Babai_the_Great" title="Babai the Great">Babai the Great</a>, pillar of Assyrian Church of the East, died </event>
<event namespace="Christianity" start="628" end="629" isDuration="true" title="Cross of Christ and Jerusalem recovered from Islam"> <a href="http://en.wikipedia.org/wiki/Battle_of_Mut%27ah" title="Battle of Mut'ah">Battle of Mut'ah</a>, <a href="http://en.wikipedia.org/wiki/Heraclius" title="Heraclius">Heraclius</a> recovered Cross of Christ and Jerusalem from Islam till 638 </event>
<event namespace="Christianity" start="632" title="Eorpwald of East Anglia baptized"> Eorpwald of <a href="http://en.wikipedia.org/wiki/East_Anglia" title="East Anglia">East Anglia</a> baptized under influence of <a href="http://en.wikipedia.org/wiki/Edwin_of_Northumbria" title="Edwin of Northumbria">Edwin of Northumbria</a> </event>
<event namespace="Christianity" start="634" end="644" isDuration="true" title="Umar conquers Syria, Egypt, Armenia, Persia"> <a href="http://en.wikipedia.org/wiki/Umar" title="Umar">Umar</a>, 2nd <a href="http://en.wikipedia.org/wiki/Sunni_Islam" title="Sunni Islam">Sunni Islam</a> <a href="http://en.wikipedia.org/wiki/Caliph" title="Caliph">Caliph</a>, capital at Damascus, conquered Syria in 635, defeated Heraclius at <a href="http://en.wikipedia.org/wiki/Battle_of_Yarmuk" title="Battle of Yarmuk">Battle of Yarmuk</a> in 636, conquered Egypt and Armenia in 639, Persia in 642 </event>
<event namespace="Christianity" start="635" title="Cynegils of Wessex baptized"> <a href="http://en.wikipedia.org/wiki/Cynegils_of_Wessex" title="Cynegils of Wessex">Cynegils of Wessex</a> baptized by Bishop <a href="http://en.wikipedia.org/wiki/Birinus" title="Birinus">Birinus</a> </event>
<event namespace="Christianity" start="640" title="Library of Alexandria destroyed"> <a href="http://en.wikipedia.org/wiki/Library_of_Alexandria" title="Library of Alexandria">Library of Alexandria</a>, "The Center of Western Culture," with 300,000 ancient papyrus scrolls, is completely destroyed. </event>
<event namespace="Christianity" start="664" title="Celtic Christianity, Roman Catholicism united"> <a href="http://en.wikipedia.org/wiki/Synod_of_Whitby" title="Synod of Whitby">Synod of Whitby</a> unites <a href="http://en.wikipedia.org/wiki/Celtic_Christianity" title="Celtic Christianity">Celtic Christianity</a> of British Isles with <a href="http://en.wikipedia.org/wiki/Roman_Catholicism" title="Roman Catholicism">Roman Catholicism</a> </event>
<event namespace="Christianity" start="680" end="681" isDuration="true" title="Third Council of Constantinople"> <a href="http://en.wikipedia.org/wiki/Third_Council_of_Constantinople" title="Third Council of Constantinople">Third Council of Constantinople</a>, 6th <a href="http://en.wikipedia.org/wiki/Ecumenical" title="Ecumenical">ecumenical</a>, against <a href="http://en.wikipedia.org/wiki/Monothelites" title="Monothelites">Monothelites</a>, condemned <a href="http://en.wikipedia.org/wiki/Pope_Honorius_I" title="Pope Honorius I">Pope Honorius I</a>, <a href="http://en.wikipedia.org/wiki/Patriarch_Sergius_I_of_Constantinople" title="Patriarch Sergius I of Constantinople">Patriarch Sergius I of Constantinople</a>, Heraclius' <i>Ecthesis</i> </event>
<event namespace="Christianity" start="681" end="686" isDuration="true" title="Wilfrid converts Sussex"> <a href="http://en.wikipedia.org/wiki/Wilfrid" title="Wilfrid">Wilfrid</a> converts <a href="http://en.wikipedia.org/wiki/Sussex" title="Sussex">Sussex</a> </event>
<event namespace="Christianity" start="687" end="691" isDuration="true" title="Dome of the Rock built"> <a href="http://en.wikipedia.org/wiki/Dome_of_the_Rock" title="Dome of the Rock">Dome of the Rock</a> built </event>
<event namespace="Christianity" start="690" title="Old English Bible translations"> <a href="http://en.wikipedia.org/wiki/Old_English_Bible_translations" title="Old English Bible translations">Old English Bible translations</a> </event>
<event namespace="Christianity" start="692" title="Canons of the Apostles approved"> Orthodox <a href="http://en.wikipedia.org/wiki/Quinisext_Council" title="Quinisext Council">Quinisext Council</a>, convoked by <a href="http://en.wikipedia.org/wiki/Justinian_II" title="Justinian II">Justinian II</a>, approved <a href="http://en.wikipedia.org/wiki/Canons_of_the_Apostles" title="Canons of the Apostles">Canons of the Apostles</a> of <a href="http://en.wikipedia.org/wiki/Apostolic_Constitutions" title="Apostolic Constitutions">Apostolic Constitutions</a>, <a href="http://en.wikipedia.org/wiki/Clerical_celibacy" title="Clerical celibacy">Clerical celibacy</a>, rejected by <a href="http://en.wikipedia.org/wiki/Pope_Constantine" title="Pope Constantine">Pope Constantine</a> </event>
<event namespace="Christianity" start="698" title="Fall of Carthage"> Fall of <a href="http://en.wikipedia.org/wiki/Carthage#Roman_Carthage" title="Carthage">Carthage</a> </event>
<event namespace="Christianity" start="711" end="718" isDuration="true" title="Islamic conquest of Iberia"> <a href="http://en.wikipedia.org/wiki/Islamic_conquest_of_Iberia" title="Islamic conquest of Iberia">Islamic conquest of Iberia</a> </event>
<event namespace="Christianity" start="717" end="718" isDuration="true" title="Second Arab siege of Constantinople"> <a href="http://en.wikipedia.org/wiki/Second_Arab_siege_of_Constantinople" title="Second Arab siege of Constantinople">Second Arab siege of Constantinople</a> </event>
<event namespace="Christianity" start="718" end="1492" isDuration="true" title="Iberian Peninsula retaken by Christendom"> <a href="http://en.wikipedia.org/wiki/Reconquista" title="Reconquista">Reconquista</a>, <a href="http://en.wikipedia.org/wiki/Iberian_Peninsula" title="Iberian Peninsula">Iberian Peninsula</a> retaken by <a href="http://en.wikipedia.org/wiki/Christendom" title="Christendom">Christendom</a> </event>
<event namespace="Christianity" start="718" title="St. Boniface evangelises Germans"> <a href="http://en.wikipedia.org/wiki/Saint_Boniface" title="Saint Boniface">Saint Boniface</a>, an Englishman, given commission by <a href="http://en.wikipedia.org/wiki/Pope_Gregory_II" title="Pope Gregory II">Pope Gregory II</a> to <a href="http://en.wikipedia.org/wiki/Evangelize" title="Evangelize">evangelize</a> the <a href="http://en.wikipedia.org/wiki/Germany" title="Germany">Germans</a> </event>
<event namespace="Christianity" start="720" title="Disentis Abbey of Switzerland"> <a href="http://en.wikipedia.org/wiki/Disentis_Abbey" title="Disentis Abbey">Disentis Abbey</a> of Switzerland </event>
<event namespace="Christianity" start="730" end="787" isDuration="true" title="First Iconoclasm"> <a href="http://en.wikipedia.org/wiki/Iconoclasm#The_first_iconoclastic_period:_730-787" title="Iconoclasm">First Iconoclasm</a>, Byzantine Emperor <a href="http://en.wikipedia.org/wiki/Leo_III_the_Isaurian" title="Leo III the Isaurian">Leo III</a> bans Christian <a href="http://en.wikipedia.org/wiki/Icon" title="Icon">icons</a>, <a href="http://en.wikipedia.org/wiki/Pope_Gregory_II" title="Pope Gregory II">Pope Gregory II</a> excommunicates him </event>
<event namespace="Christianity" start="731" title="English Church History written"> <a href="http://en.wikipedia.org/wiki/Historia_ecclesiastica_gentis_Anglorum" title="Historia ecclesiastica gentis Anglorum">English Church History</a> written by <a href="http://en.wikipedia.org/wiki/Bede" title="Bede">Bede</a> </event>
<event namespace="Christianity" start="750" title="Tower added to St. Peter's Basilica"> Tower added to St Peter's Basilica at the front of the atrium </event>
<event namespace="Christianity" start="752" title="Donation of Constantine"> <a href="http://en.wikipedia.org/wiki/Donation_of_Constantine" title="Donation of Constantine">Donation of Constantine</a>, granted <a href="http://en.wikipedia.org/wiki/Western_Roman_Empire" title="Western Roman Empire">Western Roman Empire</a> to the Pope, later proved a forgery </event>
<event namespace="Christianity" start="756" title="Donation of Pepin"> <a href="http://en.wikipedia.org/wiki/Donation_of_Pepin" title="Donation of Pepin">Donation of Pepin</a> recognizes <a href="http://en.wikipedia.org/wiki/Papal_States" title="Papal States">Papal States</a> </event>
<event namespace="Christianity" start="781" title="Nestorian Stele"> <a href="http://en.wikipedia.org/wiki/Nestorian_Stele" title="Nestorian Stele">Nestorian Stele</a> </event>
<event namespace="Christianity" start="781" title="Daqin Pagoda"> <a href="http://en.wikipedia.org/wiki/Daqin_Pagoda" title="Daqin Pagoda">Daqin Pagoda</a> </event>
<event namespace="Christianity" start="781" title="Jesus Sutras"> <a href="http://en.wikipedia.org/wiki/Jesus_Sutras" title="Jesus Sutras">Jesus Sutras</a> </event>
<event namespace="Christianity" start="781" title="Christianity in China"> <a href="http://en.wikipedia.org/wiki/Christianity_in_China" title="Christianity in China">Christianity in China</a> </event>
<event namespace="Christianity" start="787" title="Second Council of Nicaea"> <a href="http://en.wikipedia.org/wiki/Second_Council_of_Nicaea" title="Second Council of Nicaea">Second Council of Nicaea</a>, 7th <a href="http://en.wikipedia.org/wiki/Ecumenical" title="Ecumenical">ecumenical</a>, ends first Iconoclasm </event>
<event namespace="Christianity" start="793" title="Beginning of Viking raids on Christendom"> Sacking of the monastery of <a href="http://en.wikipedia.org/wiki/Lindisfarne" title="Lindisfarne">Lindisfarne</a> marks the beginning of <a href="http://en.wikipedia.org/wiki/Viking" title="Viking">Viking</a> raids on <a href="http://en.wikipedia.org/wiki/Christendom" title="Christendom">Christendom</a>. </event>
<event namespace="Christianity" start="800" title="Charlemagne crowned first Holy Roman Emperor"> King <a href="http://en.wikipedia.org/wiki/Charlemagne" title="Charlemagne">Charlemagne</a> of the <a href="http://en.wikipedia.org/wiki/Franks" title="Franks">Franks</a> is crowned first <a href="http://en.wikipedia.org/wiki/Holy_Roman_Empire" title="Holy Roman Empire">Holy Roman Emperor</a> of the West by <a href="http://en.wikipedia.org/wiki/Pope_Leo_III" title="Pope Leo III">Pope Leo III</a>. </event>
<event namespace="Christianity" start="849" end="865" isDuration="true" title="Ansgar evangelises North Germany, Denmark, Sweden"> <a href="http://en.wikipedia.org/wiki/Ansgar" title="Ansgar">Ansgar</a>, <a href="http://en.wikipedia.org/wiki/Archbishopric_of_Bremen" title="Archbishopric of Bremen">Archbishop of Bremen</a>, "Apostle of the North", began evangelisation of North Germany, <a href="http://en.wikipedia.org/wiki/Denmark" title="Denmark">Denmark</a>, <a href="http://en.wikipedia.org/wiki/Sweden" title="Sweden">Sweden</a> </event>
<event namespace="Christianity" start="855" title="Antipope Anastasius"> <a href="http://en.wikipedia.org/wiki/Antipope_Anastasius" title="Antipope Anastasius">Antipope Anastasius</a>, <a href="http://en.wikipedia.org/wiki/Louis_II%2C_Holy_Roman_Emperor" title="Louis II, Holy Roman Emperor">Louis II, Holy Roman Emperor</a> appointed him over <a href="http://en.wikipedia.org/wiki/Pope_Benedict_III" title="Pope Benedict III">Pope Benedict III</a> but popular pressure caused withdrawal </event>
<event namespace="Christianity" start="863" title="St. Cyril and St. Methodius evangelise Slavic peoples"> <a href="http://en.wikipedia.org/wiki/Saint_Cyril" title="Saint Cyril">Saint Cyril</a> and <a href="http://en.wikipedia.org/wiki/Saint_Methodius" title="Saint Methodius">Saint Methodius</a> sent by the <a href="http://en.wikipedia.org/wiki/Patriarch_of_Constantinople" title="Patriarch of Constantinople">Patriarch of Constantinople</a> to evangelise the <a href="http://en.wikipedia.org/wiki/Slavic_peoples" title="Slavic peoples">Slavic peoples</a>. They translate the Bible into <a href="http://en.wikipedia.org/wiki/Old_Church_Slavonic" title="Old Church Slavonic">Slavonic</a>. </event>
<event namespace="Christianity" start="869" end="870" isDuration="true" title="Catholic 4th Council of Constantinople condemned Patriarch Photius"> Catholic <a href="http://en.wikipedia.org/wiki/Fourth_Council_of_Constantinople" title="Fourth Council of Constantinople">Fourth Council of Constantinople</a>, condemned Patriarch <a href="http://en.wikipedia.org/wiki/Photius" title="Photius">Photius</a>, rejected by Orthodox </event>
<event namespace="Christianity" start="879" end="880" isDuration="true" title="Orthodox 4th Council of Constantinople restored Photius"> Orthodox <a href="http://en.wikipedia.org/wiki/Fourth_Council_of_Constantinople" title="Fourth Council of Constantinople">Fourth Council of Constantinople</a>, restored Photius, condemned <a href="http://en.wikipedia.org/wiki/Pope_Nicholas_I" title="Pope Nicholas I">Pope Nicholas I</a> and <a href="http://en.wikipedia.org/wiki/Filioque_clause" title="Filioque clause">Filioque</a>, rejected by Catholics </event>
<event namespace="Christianity" start="Jan 01 0897" end="Feb 01 0897" title="Trial against dead Pope Formosus"> <a href="http://en.wikipedia.org/wiki/Cadaver_Synod" title="Cadaver Synod">Cadaver Synod</a>, <a href="http://en.wikipedia.org/wiki/Pope_Stephen_VI" title="Pope Stephen VI">Pope Stephen VI</a> conducts trial against dead <a href="http://en.wikipedia.org/wiki/Pope_Formosus" title="Pope Formosus">Pope Formosus</a>, public uprising against Stephen led to his imprisonment and strangulation </event>
<event namespace="Christianity" start="909" title="Abbey of Cluny"> <a href="http://en.wikipedia.org/wiki/Abbey_of_Cluny" title="Abbey of Cluny">Abbey of Cluny</a>, <a href="http://en.wikipedia.org/wiki/Benedictine" title="Benedictine">Benedictine</a> monastery in France </event>
<event namespace="Christianity" start="948" title="Einsiedeln Abbey"> <a href="http://en.wikipedia.org/wiki/Einsiedeln_Abbey" title="Einsiedeln Abbey">Einsiedeln Abbey</a> of Switzerland </event>
<event namespace="Christianity" start="966" title="Poland becomes Christian country"> <a href="http://en.wikipedia.org/wiki/Mieszko_I" title="Mieszko I">Mieszko I</a> duke of Poland baptised, Poland becomes a Christian country. </event>
<event namespace="Christianity" start="984" title="Pope John XIV murdered"> <a href="http://en.wikipedia.org/wiki/Antipope_Boniface_VII" title="Antipope Boniface VII">Antipope Boniface VII</a>, murdered <a href="http://en.wikipedia.org/wiki/Pope_John_XIV" title="Pope John XIV">Pope John XIV</a>, alleged to have murdered <a href="http://en.wikipedia.org/wiki/Pope_Benedict_VI" title="Pope Benedict VI">Pope Benedict VI</a> in 974 </event>
<event namespace="Christianity" start="988" title="Baptism of Kievan Rus"> <a href="http://en.wikipedia.org/wiki/Baptism_of_Kievan_Rus%27" title="Baptism of Kievan Rus'">Baptism of Kievan Rus'</a> </event>
<event namespace="Christianity" start="997" end="998" isDuration="true" title="Antipope John XVI deposed"> <a href="http://en.wikipedia.org/wiki/Antipope_John_XVI" title="Antipope John XVI">Antipope John XVI</a>, deposed by <a href="http://en.wikipedia.org/wiki/Pope_Gregory_V" title="Pope Gregory V">Pope Gregory V</a> and his cousin <a href="http://en.wikipedia.org/wiki/Holy_Roman_Emperor" title="Holy Roman Emperor">Holy Roman Emperor</a> <a href="http://en.wikipedia.org/wiki/Otto_III" title="Otto III">Otto III</a> </event>
<event namespace="Christianity" start="999" title="Approach of the millennium"> Much speculation and fear regarding the approach of the <a href="http://en.wikipedia.org/wiki/Millenarianism" title="Millenarianism">millennium</a> </event>
<event namespace="Christianity" start="1012" title="Antipope Gregory VI"> <a href="http://en.wikipedia.org/wiki/Antipope_Gregory_VI" title="Antipope Gregory VI">Antipope Gregory VI</a>, removed by <a href="http://en.wikipedia.org/wiki/Henry_II%2C_Holy_Roman_Emperor" title="Henry II, Holy Roman Emperor">Henry II, Holy Roman Emperor</a> </event>
<event namespace="Christianity" start="1030" title="Battle of Stiklestand"> <a href="http://en.wikipedia.org/wiki/Battle_of_Stiklestad" title="Battle of Stiklestad">Battle of Stiklestad</a>, considered victory of Christianity over Norwegian Paganism </event>
<event namespace="Christianity" start="1045" title="Sigfrid of Sweden"> <a href="http://en.wikipedia.org/wiki/Sigfrid_of_Sweden" title="Sigfrid of Sweden">Sigfrid of Sweden</a>, Benedictine evangelist </event>
<event namespace="Christianity" start="1046" title="Council of Sutri"> <a href="http://en.wikipedia.org/wiki/Council_of_Sutri" title="Council of Sutri">Council of Sutri</a>, <a href="http://en.wikipedia.org/wiki/Pope_Silvester_III" title="Pope Silvester III">Pope Silvester III</a> exiled, <a href="http://en.wikipedia.org/wiki/Pope_Gregory_VI" title="Pope Gregory VI">Pope Gregory VI</a> admitted to <a href="http://en.wikipedia.org/wiki/Simony" title="Simony">buying the papacy</a> and resigned, <a href="http://en.wikipedia.org/wiki/Pope_Benedict_IX" title="Pope Benedict IX">Pope Benedict IX</a> resigned, council appointed <a href="http://en.wikipedia.org/wiki/Pope_Clement_II" title="Pope Clement II">Pope Clement II</a> </event>
<event namespace="Christianity" start="1054" title="East-West Schism"> <a href="http://en.wikipedia.org/wiki/East-West_Schism" title="East-West Schism">East-West Schism</a> split between Eastern (<a href="http://en.wikipedia.org/wiki/Orthodox_Christianity" title="Orthodox Christianity">Orthodox Christianity</a>) and Western (<a href="http://en.wikipedia.org/wiki/Roman_Catholic" title="Roman Catholic">Roman Catholic</a>) churches formalized </event>
<event namespace="Christianity" start="1058" end="1059" isDuration="true" title="Antipope Benedict X defeated"> <a href="http://en.wikipedia.org/wiki/Antipope_Benedict_X" title="Antipope Benedict X">Antipope Benedict X</a>, defeated in war with <a href="http://en.wikipedia.org/wiki/Pope_Nicholas_II" title="Pope Nicholas II">Pope Nicholas II</a> and <a href="http://en.wikipedia.org/wiki/Normans" title="Normans">Normans</a> </event>
<event namespace="Christianity" start="1061" end="1064" isDuration="true" title="Antipope Honorius II"> <a href="http://en.wikipedia.org/wiki/Antipope_Honorius_II" title="Antipope Honorius II">Antipope Honorius II</a> rival of <a href="http://en.wikipedia.org/wiki/Pope_Alexander_II" title="Pope Alexander II">Pope Alexander II</a> </event>
