{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline plugin manifest, API 1",
  "type": "object",
  "required": ["id", "version", "api_version", "runtime", "capabilities", "entry_point", "supported_modes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$", "not": {"const": "NONE"}},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "api_version": {"const": "1"},
    "runtime": {"enum": ["python", "java", "executable"]},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["source", "converter", "generator"]}},
    "entry_point": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"},
    "cli": {"type": "string"},
    "visibility": {"enum": ["public", "private"]},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "supported_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["once", "interval", "watch", "stream"]}},
    "options_schema": {"type": "object"},
    "config_schema": {"type": "string"},
    "requires_source_path": {"type": "boolean"}
  },
  "additionalProperties": true
}
