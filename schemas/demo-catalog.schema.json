{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openbexi.org/schemas/demo-catalog.schema.json",
  "title": "OpenBEXI live demo catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "basePath", "demos"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "basePath": {"type": "string", "minLength": 1},
    "demos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "description", "dataset", "model", "recordCount"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "dataset": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "reference": {"type": ["string", "null"], "minLength": 1},
          "recordCount": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
