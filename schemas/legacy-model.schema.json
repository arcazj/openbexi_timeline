{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openbexi.org/schemas/legacy-model.schema.json",
  "title": "OpenBEXI provider and legacy timeline model",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "params",
    "bands"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "params": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/definitions/params"
      }
    },
    "dataSource": {
      "$ref": "#/definitions/dataSource"
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/band"
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional rendering settings. Omitted properties retain the existing presentation.",
      "properties": {
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "description": "Scene and optional application surface colors.",
          "properties": {
            "sceneBackground": {
              "type": "string",
              "default": "#f7f9fc",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Canvas background."
            },
            "headerBackground": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Header background; null keeps the stylesheet theme."
            },
            "panelBackground": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Timeline panel background; null keeps the stylesheet theme."
            },
            "panelText": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Panel text color; null keeps the stylesheet theme."
            }
          }
        },
        "axis": {
          "type": "object",
          "additionalProperties": false,
          "description": "Date axes and automatic tick spacing.",
          "properties": {
            "background": {
              "type": "string",
              "default": "#f7f9fc",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Date axis and date-label background."
            },
            "separatorColor": {
              "type": "string",
              "default": "#8090a0",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Date-axis boundary color."
            },
            "textColor": {
              "type": "string",
              "default": "#233449",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Date label color."
            },
            "minimumHeight": {
              "type": "number",
              "default": 28,
              "minimum": 16,
              "maximum": 160,
              "description": "Minimum date-axis height in pixels."
            },
            "verticalPadding": {
              "type": "number",
              "default": 16,
              "minimum": 0,
              "maximum": 80,
              "description": "Additional axis height above the band font size."
            },
            "minimumFontSize": {
              "type": "number",
              "default": 12,
              "minimum": 6,
              "maximum": 48,
              "description": "Minimum canvas date-label font size in pixels."
            },
            "targetTickPixels": {
              "type": "number",
              "default": 100,
              "minimum": 30,
              "maximum": 400,
              "description": "Preferred distance between automatically chosen time labels."
            },
            "groupHeaderHeight": {
              "type": "number",
              "default": 24,
              "minimum": 12,
              "maximum": 120,
              "description": "Space reserved for a group heading."
            },
            "scaleHeaderColor": {
              "type": "string",
              "default": "#edf0f1",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Default scale-header background."
            },
            "scaleHeaderText": {
              "type": "string",
              "default": "#397a9c",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Default scale-header text."
            },
            "secondaryColor": {
              "type": "string",
              "default": "#ffd58a",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Default secondary-scale background."
            },
            "secondaryText": {
              "type": "string",
              "default": "#704308",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Default secondary-scale text."
            }
          }
        },
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "description": "Overview SVG labels, markers and visible-range indicators.",
          "properties": {
            "borderColor": {
              "type": "string",
              "default": "#aab8bf",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Top divider."
            },
            "headingColor": {
              "type": "string",
              "default": "#566871",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Heading and record-count text."
            },
            "headingFontSize": {
              "type": "number",
              "default": 11,
              "minimum": 6,
              "maximum": 32,
              "description": "Default overview heading size."
            },
            "countFontSize": {
              "type": "number",
              "default": 10,
              "minimum": 6,
              "maximum": 32,
              "description": "Record-count size."
            },
            "axisFontSize": {
              "type": "number",
              "default": 10,
              "minimum": 6,
              "maximum": 32,
              "description": "Overview date-label size."
            },
            "markerStroke": {
              "type": "string",
              "default": "#253746",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Record marker outline."
            },
            "markerStrokeWidth": {
              "type": "number",
              "default": 0.35,
              "minimum": 0,
              "maximum": 8,
              "description": "Record marker outline width."
            },
            "dimmedOpacity": {
              "type": "number",
              "default": 0.25,
              "minimum": 0,
              "maximum": 1,
              "description": "Opacity multiplier for nonmatching records during search."
            },
            "matchColor": {
              "type": "string",
              "default": "#ffe04b",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Search-match fill."
            },
            "matchOpacity": {
              "type": "number",
              "default": 0.95,
              "minimum": 0,
              "maximum": 1,
              "description": "Search-match opacity."
            },
            "matchStroke": {
              "type": "string",
              "default": "#783800",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Search-match outline and count text."
            },
            "matchStrokeWidth": {
              "type": "number",
              "default": 2,
              "minimum": 0,
              "maximum": 8,
              "description": "Search-match outline width."
            },
            "viewportColor": {
              "type": "string",
              "default": "#ffffff",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Visible-range fill."
            },
            "viewportOpacity": {
              "type": "number",
              "default": 0.08,
              "minimum": 0,
              "maximum": 1,
              "description": "Visible-range fill opacity."
            },
            "viewportStroke": {
              "type": "string",
              "default": "#536872",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Visible-range outline."
            },
            "viewportStrokeWidth": {
              "type": "number",
              "default": 1,
              "minimum": 0,
              "maximum": 8,
              "description": "Visible-range outline width."
            },
            "handleColor": {
              "type": "string",
              "default": "#eff8ff",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Visible-range handle fill."
            },
            "handleStroke": {
              "type": "string",
              "default": "#4d89ae",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Visible-range handle outline."
            },
            "handleWidth": {
              "type": "number",
              "default": 7,
              "minimum": 3,
              "maximum": 24,
              "description": "Handle width in pixels."
            },
            "handleMaxHeight": {
              "type": "number",
              "default": 48,
              "minimum": 12,
              "maximum": 120,
              "description": "Maximum handle height in pixels."
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "description": "3D camera and lighting. Existing params.camera takes precedence for initial mode.",
          "properties": {
            "mode": {
              "type": "string",
              "default": "Orthographic",
              "enum": [
                "Orthographic",
                "Perspective"
              ],
              "description": "Initial camera mode."
            },
            "fieldOfView": {
              "type": "number",
              "default": 30,
              "minimum": 10,
              "maximum": 100,
              "description": "Perspective field of view in degrees."
            },
            "yaw": {
              "type": "number",
              "default": -0.42,
              "minimum": -0.65,
              "maximum": 0.65,
              "description": "Initial horizontal orbit angle in radians."
            },
            "pitch": {
              "type": "number",
              "default": 0.22,
              "minimum": 0.06,
              "maximum": 0.46,
              "description": "Initial vertical orbit angle in radians."
            },
            "roll": {
              "type": "number",
              "default": -0.12,
              "minimum": -0.5,
              "maximum": 0.5,
              "description": "Board rotation in radians."
            },
            "rotationSensitivity": {
              "type": "number",
              "default": 0.002,
              "minimum": 0.0001,
              "maximum": 0.02,
              "description": "Shift-drag rotation per pixel."
            },
            "ambientColor": {
              "type": "string",
              "default": "#ffffff",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Perspective ambient light."
            },
            "ambientIntensity": {
              "type": "number",
              "default": 1.5,
              "minimum": 0,
              "maximum": 5,
              "description": "Perspective ambient light intensity."
            },
            "directionalColor": {
              "type": "string",
              "default": "#ffffff",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Perspective directional light."
            },
            "directionalIntensity": {
              "type": "number",
              "default": 1.8,
              "minimum": 0,
              "maximum": 5,
              "description": "Perspective directional light intensity."
            }
          }
        },
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "description": "Activity labels, 3D materials and selection brightness. Selection never enlarges activities.",
          "properties": {
            "labelMinWidth": {
              "type": "number",
              "default": 80,
              "minimum": 20,
              "maximum": 400,
              "description": "Minimum wrapping width in pixels."
            },
            "labelMaxWidth": {
              "type": "number",
              "default": 360,
              "minimum": 40,
              "maximum": 1600,
              "description": "Maximum wrapping width in pixels."
            },
            "labelHorizontalPadding": {
              "type": "number",
              "default": 24,
              "minimum": 0,
              "maximum": 200,
              "description": "Space reserved around labels."
            },
            "lineHeight": {
              "type": "number",
              "default": 1.25,
              "minimum": 1,
              "maximum": 3,
              "description": "Label line-height multiplier."
            },
            "shininess": {
              "type": "number",
              "default": 24,
              "minimum": 0,
              "maximum": 100,
              "description": "3D activity material shininess."
            },
            "shadowColor": {
              "type": "string",
              "default": "#17363d",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "3D activity shadow."
            },
            "shadowOpacity": {
              "type": "number",
              "default": 0.16,
              "minimum": 0,
              "maximum": 1,
              "description": "3D activity shadow opacity."
            },
            "laneOpacity": {
              "type": "number",
              "default": 0.08,
              "minimum": 0,
              "maximum": 1,
              "description": "3D row lane opacity."
            },
            "glowColor": {
              "type": "string",
              "default": "#ffca28",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Selected activity glow."
            },
            "glowOutline": {
              "type": "string",
              "default": "#ae5b00",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Selected activity glow outline."
            },
            "glowOpacity": {
              "type": "number",
              "default": 0.22,
              "minimum": 0,
              "maximum": 1,
              "description": "Selected activity resting glow opacity."
            },
            "glowPulse": {
              "type": "number",
              "default": 0.12,
              "minimum": 0,
              "maximum": 1,
              "description": "Additional glow opacity during the selection pulse."
            },
            "transitionMs": {
              "type": "number",
              "default": 850,
              "minimum": 0,
              "maximum": 5000,
              "description": "Selection pulse duration; zero disables animation."
            },
            "matchBackground": {
              "type": "string",
              "default": "#fff6bd",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Matching activity label background."
            },
            "leaderColor": {
              "type": "string",
              "default": "#507585",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "3D label connector."
            },
            "selectedLeaderColor": {
              "type": "string",
              "default": "#9c5900",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(#[0-9a-fA-F]{3,8}|[a-zA-Z]+|(?:rgb|hsl)a?\\([0-9.,% +\\-]+\\))$",
              "description": "Selected label connector."
            }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "description": "Responsive layout preferences; computed positions and page membership are not persisted.",
          "properties": {
            "sidebarBreakpoint": {
              "type": "number",
              "default": 900,
              "minimum": 320,
              "maximum": 2400,
              "description": "Viewport width below which the Data panel overlays the plot."
            },
            "sidebarMinimum": {
              "type": "number",
              "default": 320,
              "minimum": 180,
              "maximum": 800,
              "description": "Minimum docked Data panel width."
            },
            "sidebarDefaultMaximum": {
              "type": "number",
              "default": 480,
              "minimum": 180,
              "maximum": 1400,
              "description": "Maximum initial Data panel width."
            },
            "sidebarDefaultRatio": {
              "type": "number",
              "default": 0.22,
              "minimum": 0.1,
              "maximum": 0.7,
              "description": "Initial Data panel width relative to the viewport."
            },
            "sidebarMaximumRatio": {
              "type": "number",
              "default": 0.6,
              "minimum": 0.2,
              "maximum": 0.85,
              "description": "Maximum docked Data panel width relative to the viewport."
            },
            "minimumPlotWidth": {
              "type": "number",
              "default": 420,
              "minimum": 80,
              "maximum": 1200,
              "description": "Space retained next to a docked Data panel."
            },
            "overviewMaxHeight": {
              "type": "number",
              "default": 180,
              "minimum": 40,
              "maximum": 800,
              "description": "Maximum height per docked overview."
            },
            "minimumDetailHeight": {
              "type": "number",
              "default": 100,
              "minimum": 40,
              "maximum": 800,
              "description": "Space retained above the overview."
            },
            "splitRatio": {
              "type": "number",
              "default": 0.5,
              "minimum": 0.2,
              "maximum": 0.8,
              "description": "Timeline share of the split view width."
            }
          }
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "description": "Initial search preferences and user navigation increments. Saved/URL state still takes precedence.",
          "properties": {
            "searchMode": {
              "type": "string",
              "default": "highlight",
              "enum": [
                "highlight",
                "only"
              ],
              "description": "Initial search presentation."
            },
            "highlight": {
              "type": "boolean",
              "default": true,
              "description": "Highlight matching activities."
            },
            "autoScale": {
              "type": "boolean",
              "default": false,
              "description": "Enable density-based scaling initially."
            },
            "adaptiveRatio": {
              "type": "number",
              "default": 8,
              "minimum": 1,
              "maximum": 16,
              "description": "Maximum initial adaptive scaling ratio."
            },
            "zoomInFactor": {
              "type": "number",
              "default": 0.8,
              "minimum": 0.1,
              "maximum": 0.99,
              "description": "Zoom-in span multiplier."
            },
            "zoomOutFactor": {
              "type": "number",
              "default": 1.25,
              "minimum": 1.01,
              "maximum": 10,
              "description": "Zoom-out span multiplier."
            },
            "overviewPanFraction": {
              "type": "number",
              "default": 0.5,
              "minimum": 0.05,
              "maximum": 1,
              "description": "Overview button navigation fraction."
            },
            "overviewKeyboardFraction": {
              "type": "number",
              "default": 0.1,
              "minimum": 0.01,
              "maximum": 1,
              "description": "Overview arrow-key navigation fraction."
            },
            "resizeStep": {
              "type": "number",
              "default": 20,
              "minimum": 1,
              "maximum": 100,
              "description": "Data panel keyboard resize step in pixels."
            },
            "resizeLargeStep": {
              "type": "number",
              "default": 50,
              "minimum": 1,
              "maximum": 300,
              "description": "Shift-arrow resize step in pixels."
            }
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "description": "Labels for existing, approved view and overview actions.",
          "properties": {
            "timelineLabel": {
              "type": "string",
              "default": "Timeline",
              "minLength": 1,
              "maxLength": 160,
              "description": "Timeline view button label."
            },
            "tableLabel": {
              "type": "string",
              "default": "Table",
              "minLength": 1,
              "maxLength": 160,
              "description": "Table view button label."
            },
            "splitLabel": {
              "type": "string",
              "default": "Split",
              "minLength": 1,
              "maxLength": 160,
              "description": "Split view button label."
            },
            "previousOverviewLabel": {
              "type": "string",
              "default": "←",
              "minLength": 1,
              "maxLength": 160,
              "description": "Overview previous button label."
            },
            "previousOverviewTitle": {
              "type": "string",
              "default": "Navigate earlier",
              "minLength": 1,
              "maxLength": 160,
              "description": "Overview previous button tooltip."
            },
            "nextOverviewLabel": {
              "type": "string",
              "default": "→",
              "minLength": 1,
              "maxLength": 160,
              "description": "Overview next button label."
            },
            "nextOverviewTitle": {
              "type": "string",
              "default": "Navigate later",
              "minLength": 1,
              "maxLength": 160,
              "description": "Overview next button tooltip."
            },
            "fitOverviewLabel": {
              "type": "string",
              "default": "Fit context",
              "minLength": 1,
              "maxLength": 160,
              "description": "Fit overview button label."
            },
            "fitOverviewTitle": {
              "type": "string",
              "default": "Fit loaded context in Overview",
              "minLength": 1,
              "maxLength": 160,
              "description": "Fit overview button tooltip."
            }
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "description": "Table columns and details links.",
          "properties": {
            "emptyText": {
              "type": "string",
              "default": "No events to display.",
              "minLength": 1,
              "maxLength": 160,
              "description": "Empty table message."
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "description": "Columns in display order; field is a supported record value.",
              "default": [
                {
                  "field": "title",
                  "label": "Title"
                },
                {
                  "field": "start",
                  "label": "Start"
                },
                {
                  "field": "end",
                  "label": "End"
                },
                {
                  "field": "source",
                  "label": "Source"
                },
                {
                  "field": "status",
                  "label": "Status"
                }
              ],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "label"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "enum": [
                      "title",
                      "start",
                      "end",
                      "source",
                      "status",
                      "description",
                      "id"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "width": {
                    "type": "number",
                    "minimum": 40,
                    "maximum": 1200
                  },
                  "visible": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
